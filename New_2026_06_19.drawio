        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-86" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#1f2937;strokeColor=#111827;fontColor=#ffffff;fontSize=16;fontStyle=1;" value="۴. استیبل‌کوین‌ها — ارزهای پایدار (تحلیل عمیق)" vertex="1">
          <mxGeometry height="44" width="2400" x="320" y="23431" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-87" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#742d2d;fontSize=12;" value="استیبل‌کوین رمزارزی است که ارزشش نسبت به یک دارایی مرجع (معمولاً دلار آمریکا، اما گاهی طلا یا یورو) ثابت نگه داشته می‌شود. هدف: ترکیب مزایای رمزارزها (سرعت، امنیت، حریم خصوصی، جهانی بودن) با ثبات ارزش دارایی‌های سنتی. استیبل‌کوین‌ها ستون فقرات DeFi هستند — بدون آن‌ها، وام‌دهی، معاملات و صندوق‌های سرمایه‌گذاری به دلیل نوسانات شدید غیرممکن می‌شود." vertex="1">
          <mxGeometry height="100" width="2400" x="320" y="23491" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-88" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#742d2d;fontSize=13;fontStyle=1;" value="۱. Fiat-backed (با پشتوانه فیات)" vertex="1">
          <mxGeometry height="44" width="580" x="320" y="23611" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-89" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#742d2d;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="پشتوانه: دلار واقعی در بانک نگهداری می‌شود. قابلیت بازخرید: بله — کاربر می‌تواند (در تئوری) 1 USDT را بدهد و ۱ دلار واقعی برداشت کند.  مزیت: پایداری بالا، درک آسان عیب: نیاز به اعتماد به صادرکننده، شفافیت ذخایر مسئله‌ساز ریسک: بانک‌رانی (Bank Run) در صورت از دست رفتن اعتماد" vertex="1">
          <mxGeometry height="230" width="580" x="320" y="23661" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-90" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#742d2d;fontSize=11;" value="USDC، USDT، BUSD، TUSD، GUSD، USDP" vertex="1">
          <mxGeometry height="36" width="580" x="320" y="23901" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-91" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#742d2d;fontSize=13;fontStyle=1;" value="۲. Crypto-collateralized (با پشتوانه رمزارز)" vertex="1">
          <mxGeometry height="44" width="580" x="930" y="23611" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-92" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#742d2d;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="پشتوانه: رمزارز (مثل ETH) در قرارداد هوشمند قفل می‌شود. مکانیزم: Over-collateralized — وثیقه بیش از مقدار استیبل‌کوین صادر شده.  مزیت: غیرمتمرکز، شفاف (روی بلاکچین) عیب: ناکارآمد سرمایه — نیاز به وثیقه بیش از حد ریسک: تصفیه (Liquidation) در صورت افت شدید قیمت وثیقه" vertex="1">
          <mxGeometry height="230" width="580" x="930" y="23661" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-93" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#742d2d;fontSize=11;" value="DAI (MakerDAO)، LUSD (Liquity)， sUSD (Synthetix)، GHO (Aave)" vertex="1">
          <mxGeometry height="36" width="580" x="930" y="23901" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-94" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#742d2d;fontSize=13;fontStyle=1;" value="۳. Algorithmic (الگوریتمی)" vertex="1">
          <mxGeometry height="44" width="580" x="1540" y="23611" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-95" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#742d2d;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="پشتوانه: ندارد — از مکانیزم‌های اقتصادی و الگوریتم‌ها برای ثبات قیمت استفاده می‌کند. مکانیزم: معمولاً دو توکن (مثلاً UST + LUNA) که یکدیگر را پشتیبانی می‌کنند.   اگر قیمت &lt; 1: تشویق به بازخرید و نابودی → کاهش عرضه → افزایش قیمت   اگر قیمت &gt; 1: تشویق به ایجاد جدید → افزایش عرضه → کاهش قیمت  ریسک: «Death Spiral» — اگر اعتماد از بین برود، چرخه افول آغاز می‌شود" vertex="1">
          <mxGeometry height="230" width="580" x="1540" y="23661" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-96" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#742d2d;fontSize=11;" value="UST (فروپاشی 2022)، FRAX، USDD، AMPL" vertex="1">
          <mxGeometry height="36" width="580" x="1540" y="23901" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-97" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#742d2d;fontSize=13;fontStyle=1;" value="۴. Commodity-backed (با پشتوانه کالا)" vertex="1">
          <mxGeometry height="44" width="580" x="2150" y="23611" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-98" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#742d2d;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="پشتوانه: کالاهای فیزیکی مثل طلا، نقره، نفت. قابلیت بازخرید: هر توکن قابل بازخرید با یک اونس یا بخشی از کالاست.  مزیت: پوشش در برابر تورم، تنوع سبد دارایی عیب: نیاز به ذخیره‌سازی فیزیکی امن، وابستگی به قیمت کالا ریسک: اعتماد به نهاد نگه‌دارنده فیزیکی کالا" vertex="1">
          <mxGeometry height="230" width="580" x="2150" y="23661" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-99" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#742d2d;fontSize=11;" value="PAXG (Paxos Gold)، Tether Gold (XAUT)، Digix (DGX)" vertex="1">
          <mxGeometry height="36" width="580" x="2150" y="23901" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-100" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#742d2d;fontSize=14;fontStyle=1;" value="جدول مقایسه استیبل‌کوین‌های مهم" vertex="1">
          <mxGeometry height="40" width="2400" x="320" y="23961" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-101" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fff8b0;strokeColor=#d6b656;fontColor=#5a4a00;fontSize=11;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;" value="&lt;b&gt;نام&lt;/b&gt; | &lt;b&gt;نوع&lt;/b&gt; | &lt;b&gt;صادرکننده&lt;/b&gt; | &lt;b&gt;پشتوانه&lt;/b&gt; | &lt;b&gt;بازخرید&lt;/b&gt; | &lt;b&gt;ممیزی&lt;/b&gt; ---|---|---|---|---|--- &lt;b&gt;USDT&lt;/b&gt; | Fiat-backed | Tether Limited | دلار، اوراق | محدود | شفاف نیست &lt;b&gt;USDC&lt;/b&gt; | Fiat-backed | Circle + Centre | ۱:۱ دلار آمریکا | برای موسسات | شفاف، ماهانه &lt;b&gt;BUSD&lt;/b&gt; | Fiat-backed | Paxos + Binance | ۱:۱ دلار آمریکا | برای موسسات | شفاف &lt;b&gt;DAI&lt;/b&gt; | Crypto-backed | MakerDAO | ETH، USDC، RWA | در قرارداد | روی بلاکچین &lt;b&gt;FRAX&lt;/b&gt; | Algorithmic + Fiat | Frax Protocol | ترکیبی الگوریتمی | partial | شفاف &lt;b&gt;UST&lt;/b&gt; † | Algorithmic | Terra Labs | LUNA | بوده | فروپاشی 2022 &lt;b&gt;PAXG&lt;/b&gt; | Commodity | Paxos | طلا (1 اونس) | بله | شفاف &lt;b&gt;GUSD&lt;/b&gt; | Fiat-backed | Gemini Exchange | ۱:۱ دلار | بله با KYC | شفاف" vertex="1">
          <mxGeometry height="79" width="2400" x="320" y="24011" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-102" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#742d2d;fontSize=14;fontStyle=1;" value="تاریخچه استیبل‌کوین‌ها — خط زمانی" vertex="1">
          <mxGeometry height="40" width="2400" x="320" y="24291" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-103" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#742d2d;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" value="۲۰۱۳ — اولین ایده  مفهوم دارایی دیجیتال با قیمت ثابت در پروژه BitShares توسط Daniel Larimer مطرح شد." vertex="1">
          <mxGeometry height="160" width="290" x="320" y="24341" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-104" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#742d2d;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" value="۲۰۱۴ — BitUSD  اولین تلاش عملی — شکست خورد به دلیل ناکافی بودن وثیقه." vertex="1">
          <mxGeometry height="160" width="290" x="615" y="24341" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-105" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#742d2d;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" value="۲۰۱۴ — Tether (USDT)  اولین استیبل‌کوین موفق. شرط: ۱ میلیون دلار در بانک باشد، ۱ میلیون تتر صادر شود." vertex="1">
          <mxGeometry height="160" width="290" x="910" y="24341" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-106" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#742d2d;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" value="۲۰۱۷ — MakerDAO و DAI  اولین انقلاب استیبل‌کوین غیرمتمرکز با پشتوانه رمزارز." vertex="1">
          <mxGeometry height="160" width="290" x="1205" y="24341" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-107" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#742d2d;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" value="۲۰۱۸ — USDC  Circle و Coinbase راه‌اندازی کردند. شفاف‌ترین استیبل‌کوین فیات‌بک." vertex="1">
          <mxGeometry height="160" width="290" x="1500" y="24341" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-108" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#742d2d;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" value="۲۰۱۹-۲۰۲۱ — انفجار استیبل‌کوین‌ها  TUSD، BUSD، GUSD، UST و ده‌ها استیبل‌کوین دیگر ظهور کردند." vertex="1">
          <mxGeometry height="160" width="290" x="1795" y="24341" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-109" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#742d2d;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" value="۲۰۲۲ — فروپاشی TerraUSD (UST)  مهم‌ترین فاجعه DeFi — ضرر ۶۰ میلیارد دلاری. Death Spiral الگوریتمی." vertex="1">
          <mxGeometry height="160" width="290" x="2090" y="24341" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-110" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#742d2d;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" value="۲۰۲۳-۲۰۲۴ — رشد RWA و CBDC  تلاش برای استیبل‌کوین‌های با پشتوانه دارایی‌های دنیای واقعی و ارز دیجیتال بانک مرکزی." vertex="1">
          <mxGeometry height="160" width="290" x="2385" y="24341" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-111" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#742d2d;fontSize=14;fontStyle=1;" value="آینده استیبل‌کوین‌ها" vertex="1">
          <mxGeometry height="40" width="2400" x="320" y="24521" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-112" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d6e2ff;strokeColor=#5a7ac4;fontColor=#1e3a8a;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="CBDCs  ارزهای دیجیتال بانک مرکزی — یوان چین، دلار دیجیتال آمریکا، یورو دیجیتال. خطر رقابت با استیبل‌کوین‌های خصوصی." vertex="1">
          <mxGeometry height="160" width="580" x="320" y="24571" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-113" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d6e2ff;strokeColor=#5a7ac4;fontColor=#1e3a8a;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="RWA Stablecoins  استیبل‌کوین‌های با پشتوانه دارایی‌های دنیای واقعی: طلا، املاک، اوراق قرضه، صورتحساب‌ها." vertex="1">
          <mxGeometry height="160" width="580" x="920" y="24571" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-114" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d6e2ff;strokeColor=#5a7ac4;fontColor=#1e3a8a;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="تنظیم‌گری  MICA در اروپا، GENIUS Act در آمریکا — استانداردهای جهانی، نظارت بیشتر بر ذخایر، مجوز فعالیت." vertex="1">
          <mxGeometry height="160" width="580" x="1520" y="24571" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-115" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d6e2ff;strokeColor=#5a7ac4;fontColor=#1e3a8a;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="Privacy Stablecoins  استیبل‌کوین‌های حریم خصوصی‌محور مثل Zcash-based یا Manta — تعادل بین شفافیت و محرمانگی." vertex="1">
          <mxGeometry height="160" width="580" x="2120" y="24571" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-116" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=14;fontStyle=1;" value="مطالعه موردی: فروپاشی TerraUSD (UST) — مه ۲۰۲۲" vertex="1">
          <mxGeometry height="40" width="2400" x="320" y="24751" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-117" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;" value="UST یک استیبل‌کوین الگوریتمی بود که با LUNA (توکن خواهر) یک رابطه بازخرید ۱:۱ داشت. اگر UST &lt; 1 دلار می‌شد، کاربران می‌توانستند 1 UST را با ۱ دلار LUNA عوض کنند — این باید عرضه UST را کاهش و قیمت را به ۱ برمی‌گرداند. اما در مه ۲۰۲۲ یک حمله هماهنگ به Curve pools باعث شد قیمت UST به ۰.۹۵ برسد. ترس باعث شد کاربران دسته‌جمعی UST را با LUNA عوض کنند، که باعث چاپ عظیم LUNA و سقوط آزاد قیمت آن شد (از ۶۰ دلار به صفر). این چرخه مرگ (Death Spiral) ظرف ۷۲ ساعت ۶۰ میلیارد دلار ارزش از بین رفت.  درس‌ها: ۱) استیبل‌کوین‌های الگوریتمی خطرناک‌اند. ۲) پشتوانه واقعی لازم است. ۳) اعتماد شکننده است. ۴) تنظیم‌گری ضروری است. این اتفاق باعث شد MakerDAO به سمت RWA (دارایی‌های دنیای واقعی) حرکت کند تا پشتوانه DAI را متنوع‌تر و پایدارتر کند." vertex="1">
          <mxGeometry height="200" width="2400" x="320" y="24801" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-118" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#1f2937;strokeColor=#111827;fontColor=#ffffff;fontSize=16;fontStyle=1;" value="۵. MakerDAO — تحلیل عمیق استیبل‌کوین غیرمتمرکز DAI" vertex="1">
          <mxGeometry height="44" width="2400" x="320" y="25081" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-119" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#4a2d6b;fontSize=11;" value="چرا MakerDAO؟ بیت‌کوین و اتریوم به دلیل نوسانات بالا برای استفاده روزمره مناسب نبودند. استیبل‌کوین‌های متمرکز مثل Tether به نهادهای متمرکز وابسته بودند، ذخایرشان قابل ممیزی بلاکچینی نبود (عدم شفافیت)، و امکان سانسور و مسدودسازی دارایی‌ها توسط نهادهای نظارتی وجود داشت. MakerDAO راه‌حل: استیبل‌کوین کاملاً غیرمتمرکز، شفاف، و با پشتوانه رمزارزی." vertex="1">
          <mxGeometry height="110" width="2400" x="320" y="25141" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-120" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#4a2d6b;fontSize=13;fontStyle=1;" value="تاریخچه MakerDAO" vertex="1">
          <mxGeometry height="44" width="560" x="320" y="25271" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-121" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#4a2d6b;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="۲۰۱۴ — تأسیس توسط Rune Christensen، کارآفرین دانمارکی. ۲۰۱۵ — راه‌اندازی Single-Collateral DAI (تنها با ETH). ۲۰۱۷ — نسخه Multi-Collateral DAI (MCD) با پشتوانه چند دارایی. ۲۰۲۰ — اضافه شدن USDC، WBTC، و دارایی‌های RWA به پشتوانه. ۲۰۲۲ — تثبیت DAI در Terra collapse — موفق. ۲۰۲۳-۲۰۲۴ — Endgame Plan: Sky Protocol، NewGovToken (SKY)، USDS." vertex="1">
          <mxGeometry height="180" width="560" x="320" y="25321" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-122" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#4a2d6b;fontSize=13;fontStyle=1;" value="معماری فنی —.components اصلی" vertex="1">
          <mxGeometry height="44" width="560" x="920" y="25271" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-123" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#4a2d6b;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="۱. Vault (CDP — Collateralized Debt Position)    محلی که کاربران دارایی‌هایشان را به عنوان وثیقه قفل می‌کنند و در ازای آن DAI قرض می‌گیرند.  ۲. DAI — توکن استیبل‌کوین    Soft-Peg به دلار: 1 DAI ≈ 1 USD. از طریق مکانیزم‌های اقتصادی حفظ می‌شود.  ۳. Oracles — سیستم قیمتی    قیمت‌ها را از دنیای بیرون به بلاکچین می‌آورد.  ۴. Liquidation Engine — موتور تصفیه    Vaultهای ناسالم را شناسایی و تصفیه می‌کند.  ۵. MKR — توکن حاکمیتی    держارها روی پارامترهای سیستم رأی می‌دهند." vertex="1">
          <mxGeometry height="300" width="560" x="920" y="25321" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-124" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#4a2d6b;fontSize=13;fontStyle=1;" value="مکانیزم Vault — Over-collateralization" vertex="1">
          <mxGeometry height="44" width="560" x="1520" y="25271" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-125" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#4a2d6b;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="وقتی می‌خواهیم ۱ دلار از سیستم بکشیم، باید معادل ۱.۵ دلار اتریوم به عنوان وثیقه بگذاریم. این ۱.۵ دلار اتر در قرارداد هوشمند قفل می‌شود و یک انشعاب از آن گرفته می‌شود:  • خروجی ۱: ۱ DAI (استیبل‌کوین ما، قرار است ۱ دلار باشد) • خروجی ۲: CDP به ارزش ۰.۵ دلار (مالکیت وثیقه پس از بازپرداخت)  مزیت: اگر اتریوم ۲ برابر شود، وثیقه ما ۳ دلار می‌شود — سود. ریسک: اگر اتریوم ۲/۳ بریزد، یعنی وثیقه ۱.۵ دلاری به ۱ دلار می‌رسد — موقعیت بی‌ارزش می‌شود و Liquidation رخ می‌دهد." vertex="1">
          <mxGeometry height="300" width="560" x="1520" y="25321" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-126" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#4a2d6b;fontSize=13;fontStyle=1;" value="مراحل استفاده از Vault" vertex="1">
          <mxGeometry height="44" width="600" x="2120" y="25271" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-127" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#4a2d6b;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="گام ۱ — کاربر وثیقه (ETH) را به Vault واریز می‌کند. گام ۲ — سیستم نسبت وثیقه‌سازی (Collateralization Ratio) را بررسی می‌کند. گام ۳ — کاربر می‌تواند تا سقف مشخصی DAI ایجاد کند. گام ۴ — برای بازیابی وثیقه، باید Stability Fee + DAI پرداخت کند. گام ۵ — DAI ایجادشده سوزانده می‌شود و وثیقه آزاد می‌گردد.  قانون طلایی: Liquidation Ratio = ۱۵۰٪ (برای ETH). جریمه تصفیه: ۱۳٪. Stability Fee: متغیر، توسط حاکمیت تعیین می‌شود." vertex="1">
          <mxGeometry height="300" width="600" x="2120" y="25321" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-128" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0e2d0;strokeColor=#a07a4f;fontColor=#4a3520;fontSize=14;fontStyle=1;" value="سیستم Oracle در MakerDAO — چگونه قیمت‌ها به بلاکچین می‌آیند؟" vertex="1">
          <mxGeometry height="40" width="2400" x="320" y="25651" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-129" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0e2d0;strokeColor=#a07a4f;fontColor=#4a3520;fontSize=11;" value="قراردادهای هوشمند نمی‌توانند مستقیماً به داده‌های خارج از بلاکچین دسترسی داشته باشند. این «مشکل اوراکل» توسط یک سیستم چندلایه‌ای حل می‌شود. MakerDAO از یک ساختار فدراسیون‌محور استفاده می‌کند که در برابر دستکاری مقاوم است." vertex="1">
          <mxGeometry height="70" width="2400" x="320" y="25701" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-130" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0e2d0;strokeColor=#a07a4f;fontColor=#4a3520;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="1. Feeds (خوراک‌ها)  نودهای مستقل (۱۴-۲۶ feed) که قیمت‌ها را از چندین صرافی دریافت می‌کنند، امضا می‌کنند و ارسال می‌کنند. هر feed توسط DAO تأیید می‌شود." vertex="1">
          <mxGeometry height="160" width="580" x="320" y="25781" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-131" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0e2d0;strokeColor=#a07a4f;fontColor=#4a3520;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="2. Medianizer  قرارداد هوشمندی که میانه قیمت‌ها را محاسبه می‌کند. استفاده از میانه (نه میانگین) مقاومت در برابر دستکاری را بالا می‌برد — نیاز به اکثریت برای تأیید قیمت." vertex="1">
          <mxGeometry height="160" width="580" x="920" y="25781" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-132" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0e2d0;strokeColor=#a07a4f;fontColor=#4a3520;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="3. OSM (Oracle Security Module)  تأخیر ۱ ساعته قبل از انتشار قیمت نهایی. این تأخیر به تیم امنیت فرصت می‌دهد در صورت حمله (مثل Flash Loan Attack) مداخله کنند." vertex="1">
          <mxGeometry height="160" width="580" x="1520" y="25781" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-133" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0e2d0;strokeColor=#a07a4f;fontColor=#4a3520;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="4. MakerDAO Consumers  قراردادهای هوشمند MakerDAO (مثل Liquidation Engine) از این قیمت تأییدشده استفاده می‌کنند." vertex="1">
          <mxGeometry height="160" width="580" x="2120" y="25781" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-134" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=14;fontStyle=1;" value="امنیت Oracle — چگونه در برابر حملات مقاوم است؟" vertex="1">
          <mxGeometry height="40" width="2400" x="320" y="25961" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-135" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;" value="۱. استفاده از میانه به جای میانگین — یک feed مخرب نمی‌تواند قیمت را به طور قابل‌ملاحظه‌ای جابجا کند. ۲. نیاز به اکثریت برای تأیید قیمت — حداقل نیمی از feedها باید هم‌نظر باشند. ۳. تأخیر زمانی ۱ ساعته (OSM) — فرصت واکنش به Flash Loan Attacks و Emergency Shutdown. ۴. Emergency Shutdown — در صورت تشخیص حمله، سیستم می‌تواند قیمت‌ها را فریز کند. ۵. Decentralized Feeds — feedها از نهادهای مختلف (مثل Coinbase، Binance، Chainlink nodes) انتخاب می‌شوند. ۶. Governance Review — اضافه/حذف feedها توسط رأی‌گیری MKR holders انجام می‌شود." vertex="1">
          <mxGeometry height="160" width="2400" x="320" y="26011" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-136" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#742d2d;fontSize=14;fontStyle=1;" value="مکانیزم تثبیت قیمت DAI — چگونه ۱ DAI ≈ ۱ دلار نگه داشته می‌شود؟" vertex="1">
          <mxGeometry height="40" width="2400" x="320" y="26191" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-137" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#742d2d;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="اگر DAI &gt; 1 دلار (مثلاً ۱.۰۵):  • تشویق به ایجاد DAI جدید • کاربران وثیقه می‌گذارند و DAI می‌سازند • عرضه DAI افزایش می‌یابد • قیمت به ۱ دلار برمی‌گردد  ابزار: کاهش Stability Fee، کاهش Savings Rate" vertex="1">
          <mxGeometry height="240" width="580" x="320" y="26241" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-138" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#742d2d;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="اگر DAI &lt; 1 دلار (مثلاً ۰.۹۵):  • تشویق به بازخرید و نابودی DAI • کاربران DAI را با تخفیف می‌خرند و وثیقه را آزاد می‌کنند • عرضه DAI کاهش می‌یابد، تقاضا افزایش می‌یابد • قیمت به ۱ دلار برمی‌گردد  ابزار: افزایش Stability Fee، افزایش DAI Savings Rate" vertex="1">
          <mxGeometry height="240" width="580" x="930" y="26241" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-139" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#742d2d;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="ابزارهای دیگر حاکمیت:  • PSM (Peg Stability Module) — تعویض مستقیم USDC با DAI با نسبت ۱:۱ (با کارمزد جزئی) • MKR Mint/Burn — برای پوشش کسری‌ها، توکن MKR ضرب می‌شود • Surplus Buffer — سود حاصل از Stability Fees و Liquidation Penalties • Dai Savings Rate (DSR) — کاربران DAI خود را سپرده‌گذاری و سود دریافت می‌کنند" vertex="1">
          <mxGeometry height="240" width="580" x="1540" y="26241" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-140" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#742d2d;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="PSM — Peg Stability Module  مهم‌ترین ابزار تثبیت قیمت DAI. کاربران می‌توانند ۱ USDC را با ۱ DAI عوض کنند (به علاوه کارمزد ۰.۱٪). این یک طرف بازار ایجاد می‌کند که قیمت DAI را به ۱ دلار می‌چسباند.  مزیت: ثبات قطعی عیب: وابستگی به USDC (که متمرکز است)" vertex="1">
          <mxGeometry height="240" width="570" x="2150" y="26241" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-141" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=14;fontStyle=1;" value="Liquidation Engine — موتور تصفیه" vertex="1">
          <mxGeometry height="40" width="2400" x="320" y="26511" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-142" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;" value="وظیفه: حفظ پشتوانه کافی سیستم با تصفیه Vaultهای ناسالم.  &lt;b&gt;مراحل تصفیه:&lt;/b&gt; ۱. شناسایی Vault ناسالم — وقتی (ارزش وثیقه / بدهی DAI) &lt; Liquidation Ratio (مثلاً ۱۵۰٪) ۲. شروع حراج — وثیقه به حراج گذاشته می‌شود. ربات‌های خودکار (Keepers) شرکت می‌کنند. ۳. فروش وثیقه — بالاترین پیشنهاددهنده وثیقه را می‌خرد. DAI بدهی + جریمه پرداخت می‌شود. ۴. تسویه — اگر وثیقه اضافی باشد به مالک برگردانده می‌شود؛ اگر کسری باشد از Protocol Surplus پوشش داده می‌شود.  &lt;b&gt;مفاهیم کلیدی:&lt;/b&gt; • Liquidation Ratio: حداقل نسبت وثیقه مجاز (۱۵۰٪) • Liquidation Penalty: جریمه تصفیه (۱۳٪) • Keepers: ربات‌های مستقل که فرصت‌های آربیتراژ را پیدا و اجرا می‌کنند  &lt;b&gt;مثال:&lt;/b&gt; وضعیت اولیه: وثیقه = ۱۰ ETH × ۲۰۰۰$ = ۲۰٬۰۰۰$، بدهی = ۱۰٬۰۰۰ DAI، نسبت = ۲۰۰٪ اگر ETH به ۱۴۰۰$ برسد: وثیقه = ۱۴٬۰۰۰$، نسبت = ۱۴۰٪ &lt; ۱۵۰٪ → تصفیه می‌شود." vertex="1">
          <mxGeometry height="420" width="1180" x="320" y="26561" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-143" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=13;fontStyle=1;" value="Emergency Shutdown — خاموشی اضطراری" vertex="1">
          <mxGeometry height="44" width="580" x="1530" y="26561" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-144" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="آخرین خط دفاعی سیستم. در صورت حمله، باگ بحرانی، یا تصمیم حاکمیت، سیستم به طور کامل متوقف می‌شود:  ۱. توقف تولید DAI جدید ۲. فریز تمام Oracle prices ۳. بازگشت وثیقه‌ها به دارنده‌های DAI به نسبت دارایی‌های باقی‌مانده ۴. هر ۱ DAI می‌تواند بخشی از سبد وثیقه را بازخرید کند  هدف: در بدترین حالت، DAI به یک سبد از دارایی‌های پشتیبان تبدیل می‌شود." vertex="1">
          <mxGeometry height="260" width="580" x="1530" y="26611" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-145" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#4a2d6b;fontSize=13;fontStyle=1;" value="Maker Buffer — سرمایه احتیاطی" vertex="1">
          <mxGeometry height="44" width="580" x="2140" y="26561" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-146" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#4a2d6b;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="صندوق ذخیره پروتکل برای جذب ضررها و حفظ ثبات سیستم.  &lt;b&gt;منابع تأمین:&lt;/b&gt; • Stability Fees (کارمزد وام‌ها) • Liquidation Penalties (جریمه تصفیه) • سود RWA (دارایی‌های دنیای واقعی)  &lt;b&gt;کاربردها:&lt;/b&gt; • پوشش کسری در تصفیه‌ها • پرداخت هزینه‌های عملیاتی • تأمین مالی توسعه پروتکل • اگر Buffer سرریز شود، MKR holders آن را به عنوان سود تقسیم می‌کنند" vertex="1">
          <mxGeometry height="260" width="580" x="2140" y="26611" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-147" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#1f2937;strokeColor=#111827;fontColor=#ffffff;fontSize=16;fontStyle=1;" value="۶. صرافی‌های غیرمتمرکز (DEX) و AMM — تحلیل عمیق" vertex="1">
          <mxGeometry height="44" width="2400" x="320" y="27061" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-148" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b1ddf0;strokeColor=#4d9bcf;fontColor=#1e4d6b;fontSize=11;" value="صرافی‌های غیرمتمرکز (Decentralized Exchanges) قلب اکوسیستم DeFi هستند. برخلاف صرافی‌های متمرکز (مثل Binance یا Coinbase)، DEX کنترل دارایی کاربر را به دست نمی‌گیرد — کاربر همیشه مالک کیف پول خودش است. معامله به صورت هم‌دماد (peer-to-peer) از طریق قراردادهای هوشمند انجام می‌شود. سه مدل اصلی DEX وجود دارد: AMM، Order Book، و Aggregator." vertex="1">
          <mxGeometry height="110" width="2400" x="320" y="27121" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-149" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b1ddf0;strokeColor=#4d9bcf;fontColor=#1e4d6b;fontSize=14;fontStyle=1;" value="سه مدل اصلی DEX" vertex="1">
          <mxGeometry height="40" width="2400" x="320" y="27251" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-150" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b1ddf0;strokeColor=#4d9bcf;fontColor=#1e4d6b;fontSize=13;fontStyle=1;" value="۱. AMM (Automated Market Maker)" vertex="1">
          <mxGeometry height="44" width="760" x="320" y="27301" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-151" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b1ddf0;strokeColor=#4d9bcf;fontColor=#1e4d6b;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="مدل غالب در DEX. به جای Order Book، از «استخر نقدینگی» (Liquidity Pool) استفاده می‌کند. قیمت به صورت خودکار توسط یک فرمول ریاضی تعیین می‌شود.  &lt;b&gt;فرمول Constant Product (Uniswap V2):&lt;/b&gt;    x * y = k    x = مقدار توکن A در استخر    y = مقدار توکن B در استخر    k = ثابت  هر معامله، نسبت x/y را تغییر می‌دهد و قیمت جدید محاسبه می‌شود.  &lt;b&gt;مزایا:&lt;/b&gt; اجرای فوری، نیازی به بازارساز ندارد، کار با هر توکن ERC-20. &lt;b&gt;عیوب:&lt;/b&gt; Impermanent Loss، Slippage در معاملات بزرگ، عدم پشتیبانی از limit orders." vertex="1">
          <mxGeometry height="380" width="760" x="320" y="27351" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-152" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b1ddf0;strokeColor=#4d9bcf;fontColor=#1e4d6b;fontSize=13;fontStyle=1;" value="۲. Order Book DEX" vertex="1">
          <mxGeometry height="44" width="760" x="1100" y="27301" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-153" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b1ddf0;strokeColor=#4d9bcf;fontColor=#1e4d6b;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="مدل سنتی بورس — خریداران و فروشندگان سفارش‌های خود را در دفتر سفارشات ثبت می‌کنند. Match Engine سفارش‌های منطبق را پیدا و اجرا می‌کند.  &lt;b&gt;چالش در بلاکچین:&lt;/b&gt; • ذخیره و به‌روزرسانی Order Book گران است • سرعت بلاکچین محدودیت ایجاد می‌کند • نیاز به L2 یا AppChain  &lt;b&gt;راه‌حل‌ها:&lt;/b&gt; • dYdX — روی StarkEx (Validium L2) • Hyperliquid — AppChain اختصاصی • Vertex — روی Arbitrum • Aevo — Options order book روی L2  &lt;b&gt;مزایا:&lt;/b&gt; پشتیبانی از limit orders، قیمت دقیق‌تر، امکان trading پیشرفته. &lt;b&gt;عیوب:&lt;/b&gt; پیچیده‌تر، نیاز به L2، تجربه کاربری سخت‌تر." vertex="1">
          <mxGeometry height="380" width="760" x="1100" y="27351" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-154" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b1ddf0;strokeColor=#4d9bcf;fontColor=#1e4d6b;fontSize=13;fontStyle=1;" value="۳. DEX Aggregator" vertex="1">
          <mxGeometry height="44" width="840" x="1880" y="27301" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-155" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b1ddf0;strokeColor=#4d9bcf;fontColor=#1e4d6b;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="DEX Aggregator یک صرافی مستقل نیست — سرویسی است که بهترین قیمت را از چندین DEX پیدا می‌کند و معامله را split می‌کند.  &lt;b&gt;چگونه کار می‌کند:&lt;/b&gt; ۱. کاربر می‌خواهد ۱۰۰ ETH را به USDC تبدیل کند ۲. Aggregator قیمت‌ها را از Uniswap، Curve، Balancer، Sushi دریافت می‌کند ۳. ممکن است معامله را بین چند DEX تقسیم کند تا slippage کمینه شود ۴. معامله در یک تراکنش اجرا می‌شود  &lt;b&gt;مثال:&lt;/b&gt; تبدیل ۱۰ ETH به USDC:    • ۶ ETH در Uniswap (قیمت بهتر)    • ۴ ETH در Curve (کمترین slippage)  &lt;b&gt;پلتفرم‌های معروف:&lt;/b&gt; 1inch، Paraswap، Matcha، 0x API، CowSwap" vertex="1">
          <mxGeometry height="380" width="840" x="1880" y="27351" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-156" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b1ddf0;strokeColor=#4d9bcf;fontColor=#1e4d6b;fontSize=14;fontStyle=1;" value="نسل‌های AMM — از Uniswap V2 تا V4" vertex="1">
          <mxGeometry height="40" width="2400" x="320" y="27761" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-157" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b1ddf0;strokeColor=#4d9bcf;fontColor=#1e4d6b;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="Uniswap V2 (2018)  Constant Product (x*y=k)  • هر استخر دو توکن دارد • نقدینگی‌دهندگان توکن LP دریافت می‌کنند • کارمزد ثابت ۰.۳٪ • ساده، انعطاف‌پذیر، استاندارد طلایی • مشکل: Impermanent Loss بالا، ناکارآمد برای دارایی‌های مشابه" vertex="1">
          <mxGeometry height="320" width="460" x="320" y="27811" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-158" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b1ddf0;strokeColor=#4d9bcf;fontColor=#1e4d6b;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="Uniswap V3 (2021)  Concentrated Liquidity  • LPها می‌توانند نقدینگی را در یک بازه قیمت متمرکز کنند • کارایی سرمایه تا ۴۰۰۰ برابر بیشتر • چندین سطح کارمزد (0.01% تا 1%) • مشکل: مدیریت فعال نیاز است، IL بیشتر • توکن‌های NFT به جای ERC-20 برای LP" vertex="1">
          <mxGeometry height="320" width="460" x="800" y="27811" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-159" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b1ddf0;strokeColor=#4d9bcf;fontColor=#1e4d6b;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="Uniswap V4 (2024)  Hooks &amp; Singleton  • Hooks: قراردادهای سفارشی برای سفارشی‌سازی کامل • Singleton: همه استخرها در یک قرارداد — کاهش gas • Native ETH support (دوباره) • Flash accounting — بهینه‌سازی تراکنش‌های پیچیده •+EIP-1155 поддержка" vertex="1">
          <mxGeometry height="320" width="460" x="1280" y="27811" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-160" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b1ddf0;strokeColor=#4d9bcf;fontColor=#1e4d6b;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="Curve Finance  StableSwap (Modified)  • بهینه‌شده برای دارایی‌های با قیمت مشابه (استیبل‌کوین‌ها) • فرمول: کمترین slippage برای دارایی‌های پگ‌شده • کارمزد بسیار پایین (۰.۰۴٪) • استخرهای چندتوکنی (مثل 3pool: USDC+USDT+DAI) • پاداش با CRV token" vertex="1">
          <mxGeometry height="320" width="460" x="1760" y="27811" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-161" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b1ddf0;strokeColor=#4d9bcf;fontColor=#1e4d6b;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="Balancer V2  Multi-token Pools  • استخرهای با N توکن (تا ۸ توکن) • وزن‌های قابل تنظیم (مثلاً 60% ETH / 40% DAI) • Internal Vault — کاهش gas و بهبود امنیت • مدیریت خودکار سبد (auto-rebalancing) • Custom AMM logic از طریق Vault" vertex="1">
          <mxGeometry height="320" width="460" x="2240" y="27811" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-162" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=14;fontStyle=1;" value="Impermanent Loss (IL) — زیان موقت — مهم‌ترین ریسک LP" vertex="1">
          <mxGeometry height="40" width="2400" x="320" y="28161" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-163" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;" value="Impermanent Loss اختلاف ارزش بین نگه‌داشتن دارایی‌ها در کیف پول (HODL) و نگه‌داشتن آن‌ها در استخر نقدینگی است. وقتی قیمت نسبی دو توکن تغییر می‌کند، LP متضرر می‌شود.  &lt;b&gt;مثال:&lt;/b&gt; شما ۱ ETH + ۲۰۰۰ USDC را (با قیمت ETH = ۲۰۰۰$) به استخر اضافه می‌کنید.    ارزش اولیه: ۴۰۰۰$  حالت ۱: ETH به ۳۰۰۰$ برسد → اگر HODL می‌کردید: ۱×۳۰۰۰ + ۲۰۰۰ = ۵۰۰۰$    اما در استخر (طبق x*y=k): ۰.۸۱۶ ETH + ۲۴۴۹ USDC ≈ ۴۸۹۹$  → IL ≈ ۱۰۱$ (۲٪)  حالت ۲: ETH به ۱۰۰۰$ برسد → HODL: ۱×۱۰۰۰ + ۲۰۰۰ = ۳۰۰۰$    در استخر: ۱.۴۱۴ ETH + ۱۴۱۴ USDC ≈ ۲۸۲۸$  → IL ≈ ۱۷۲$ (۵.۷٪)  &lt;b&gt;قانون کلی:&lt;/b&gt; • تغییر ۱.۲۵x قیمت → ۰.۶٪ IL • تغییر ۱.۵x قیمت → ۲٪ IL • تغییر ۲x قیمت → ۵.۷٪ IL • تغییر ۳x قیمت → ۱۳.۴٪ IL • تغییر ۴x قیمت → ۲۰٪ IL  &lt;b&gt;راه‌های کاهش:&lt;/b&gt; ۱. استخرهای با دارایی‌های مشابه (استیبل‌کوین به استیبل‌کوین — Curve) ۲. پاداش توکن (yield farming) که بیشتر از IL باشد ۳. Hedging با قراردادهای مشتقه ۴. Concentrated liquidity با مدیریت فعال (V3)" vertex="1">
          <mxGeometry height="480" width="2400" x="320" y="28211" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-164" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b1ddf0;strokeColor=#4d9bcf;fontColor=#1e4d6b;fontSize=14;fontStyle=1;" value="Liquidity Pools — استخرهای نقدینگی" vertex="1">
          <mxGeometry height="40" width="2400" x="320" y="28711" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-165" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b1ddf0;strokeColor=#4d9bcf;fontColor=#1e4d6b;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="LP Tokens  وقتی کاربر نقدینگی به استخر اضافه می‌کند، توکن LP دریافت می‌کند. این توکن نماینده سهم او از استخر است. در V2 ERC-20، در V3 NFT." vertex="1">
          <mxGeometry height="160" width="780" x="320" y="28761" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-166" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b1ddf0;strokeColor=#4d9bcf;fontColor=#1e4d6b;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="Yield Sources  کارمزد معاملات (۰.۰۵٪ تا ۱٪) به نقدینگی‌دهندگان تعلق می‌گیرد. اضافه‌برآن، پاداش توکن‌های پروتکل (مثل UNI، CRV، BAL)." vertex="1">
          <mxGeometry height="160" width="780" x="1120" y="28761" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-167" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b1ddf0;strokeColor=#4d9bcf;fontColor=#1e4d6b;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="Total Value Locked (TVL)  مهم‌ترین متریک DEX — کل ارزش قفل‌شده در استخرها. Uniswap TVL: ~$6B، Curve: ~$2B، Balancer: ~$1B (متغیر)." vertex="1">
          <mxGeometry height="160" width="780" x="1920" y="28761" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-168" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b1ddf0;strokeColor=#4d9bcf;fontColor=#1e4d6b;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="Concentrated Liquidity (V3)  نقدینگی‌دهندگان می‌توانند بازه قیمتی انتخاب کنند. مثلاً ETH در بازه ۲۰۰۰-۳۰۰۰$. کارایی سرمایه بالا، اما مدیریت فعال و ریسک بالاتر." vertex="1">
          <mxGeometry height="160" width="780" x="320" y="28941" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-169" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b1ddf0;strokeColor=#4d9bcf;fontColor=#1e4d6b;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="TWAP Oracle  استخرهای AMM منبع قیمت‌های روی زنجیره هستند. میانگین زمان‌وزن‌دار (TWAP) برای محاسبه قیمت مقاوم در برابر دستکاری استفاده می‌شود." vertex="1">
          <mxGeometry height="160" width="780" x="1120" y="28941" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-170" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b1ddf0;strokeColor=#4d9bcf;fontColor=#1e4d6b;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="MEV Protection  ساندویچ اکسپلویت (Sandwich Attack) ریسک بزرگ برای کاربران DEX است. راه‌حل‌ها: CowSwap، 1inch Fusion، Uniswap X — معاملات آفلاین و توافق‌محور." vertex="1">
          <mxGeometry height="160" width="780" x="1920" y="28941" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-171" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#1f2937;strokeColor=#111827;fontColor=#ffffff;fontSize=16;fontStyle=1;" value="۷. وام‌دهی و قرض‌گیری در DeFi — تحلیل عمیق" vertex="1">
          <mxGeometry height="44" width="2400" x="320" y="29201" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-172" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b4e7c8;strokeColor=#588878;fontColor=#1f4a3c;fontSize=11;" value="پروتکل‌های وام‌دهی DeFi (Lending &amp; Borrowing) معادل بانک‌های سنتی هستند. کاربران می‌توانند دارایی‌هایشان را سپرده‌گذاری کنند و سود دریافت کنند، یا با ارائه وثیقه، وام بگیرند. تفاوت با بانک: همه چیز خودکار، شفاف، و بدون بررسی اعتبار سنتی. اصل اساسی: &lt;b&gt;Over-collateralization&lt;/b&gt; — وام‌گیرنده باید بیش از مقدار وام وثیقه بگذارد." vertex="1">
          <mxGeometry height="110" width="2400" x="320" y="29261" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-173" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b4e7c8;strokeColor=#588878;fontColor=#1f4a3c;fontSize=14;fontStyle=1;" value="مکانیزم کلی پروتکل‌های وام‌دهی" vertex="1">
          <mxGeometry height="40" width="2400" x="320" y="29391" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-174" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b4e7c8;strokeColor=#588878;fontColor=#1f4a3c;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="وام‌دهنده (Lender / Supplier)  • دارایی (ETH، USDC، ...) را در قرارداد سپرده می‌گذارد • توکن aToken (Aave) یا cToken (Compound) دریافت می‌کند — نماینده سپرده + سود انباشته • هر بلوک سود به طور خودکار اضافه می‌شود • هر زمان می‌تواند سپرده + سود را برداشت کند • نرخ بهره متغیر است — با تقاضای وام افزایش می‌یابد  &lt;b&gt;مثال:&lt;/b&gt; سپرده ۱۰۰۰ USDC، نرخ ۵٪ → بعد از ۱ سال: ۱۰۵۰ USDC" vertex="1">
          <mxGeometry height="290" width="780" x="320" y="29441" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-175" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b4e7c8;strokeColor=#588878;fontColor=#1f4a3c;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="وام‌گیرنده (Borrower)  • باید وثیقه با ارزش بیشتر از وام بگذارد (مثلاً ۱۵۰٪) • می‌تواند تا سقف مشخصی وام بگیرد • بهره متغیر یا ثابت (Aave) پرداخت می‌کند • هر زمان می‌تواند وام را بازپرداخت کند • اگر ارزش وثیقه زیر حد آستانه برسد، Liquidation رخ می‌دهد  &lt;b&gt;مثال:&lt;/b&gt; ۱ ETH (۲۰۰۰$) وثیقه → می‌تواند تا ۱۳۳۳$ وام بگیرد (۷۵٪ LTV) کاربردها: اهرم‌سازی، تأمین نقدینگی بدون فروش دارایی، Short کردن" vertex="1">
          <mxGeometry height="290" width="780" x="1120" y="29441" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-176" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b4e7c8;strokeColor=#588878;fontColor=#1f4a3c;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="تصفیه‌کننده (Liquidator / Keeper)  • ربات‌های خودکار که وضعیت وام‌ها را رصد می‌کنند • وقتی Health Factor &lt; ۱، می‌توانند وثیقه را تصفیه کنند • بدهی وام‌گیرنده را با تخفیف پرداخت می‌کنند • وثیقه را با پاداش (Liquidation Bonus) دریافت می‌کنند • معمولاً ۵-۱۰٪ پاداش  &lt;b&gt;Health Factor = (ارزش وثیقه × Liquidation Threshold) / بدهی&lt;/b&gt; HF &gt; 1 → امن   |   HF = 1 → آستانه   |   HF &lt; 1 → قابل تصفیه" vertex="1">
          <mxGeometry height="290" width="800" x="1920" y="29441" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-177" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b4e7c8;strokeColor=#588878;fontColor=#1f4a3c;fontSize=14;fontStyle=1;" value="پلتفرم‌های مهم وام‌دهی — مقایسه" vertex="1">
          <mxGeometry height="40" width="2400" x="320" y="29751" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-178" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fff8b0;strokeColor=#d6b656;fontColor=#5a4a00;fontSize=11;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;" value="&lt;b&gt;پلتفرم&lt;/b&gt; | &lt;b&gt;مدل توکن&lt;/b&gt; | &lt;b&gt;ویژگی منحصر&lt;/b&gt; | &lt;b&gt;TVL تقریبی&lt;/b&gt; | &lt;b&gt;زنجیره&lt;/b&gt; ---|---|---|---|--- &lt;b&gt;Aave&lt;/b&gt; | aToken | Flash Loans، نرخ ثابت/متغیر، GHO stablecoin | ~$12B | Multi-chain &lt;b&gt;Compound&lt;/b&gt; | cToken | مدل کاربردی، Cometh، Comet (V3) | ~$2.5B | Multi-chain &lt;b&gt;MakerDAO/Spark&lt;/b&gt; | DAI | استیبل‌کوین غیرمتمرکز، Spark Lending | ~$8B | Ethereum &lt;b&gt;Liquity&lt;/b&gt; | LUSD | غیرمتمرکز کامل، Stake Bounties، Trove | ~$300M | Ethereum &lt;b&gt;Fraxlend&lt;/b&gt; | FRAX | نرخ بهره پویا، vAMM-style | ~$100M | Multi-chain &lt;b&gt;Morpho&lt;/b&gt; | - | Optimizer روی Aave/Compound، Peer-to-peer | ~$4B | Ethereum &lt;b&gt;Spark&lt;/b&gt; | - | DAI-native، MakerDAO lending market | ~$1B | Ethereum &lt;b&gt; Radiant&lt;/b&gt; | - | Cross-chain lending | ~$300M | Multi-chain" vertex="1">
          <mxGeometry height="95" width="2400" x="320" y="29801" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-179" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b4e7c8;strokeColor=#588878;fontColor=#1f4a3c;fontSize=14;fontStyle=1;" value="Flash Loan — وام برق‌آسا — امکان منحصر DeFi" vertex="1">
          <mxGeometry height="40" width="2400" x="320" y="30061" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-180" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b4e7c8;strokeColor=#588878;fontColor=#1f4a3c;fontSize=11;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;" value="Flash Loan یک وام بدون وثیقه است که باید در همان تراکنش (همان بلوک) بازپرداخت شود. اگر بازپرداخت انجام نشود، کل تراکنش revert می‌شود و انگار اتفاقی نیفتاده. این مفهوم فقط در بلاکچین ممکن است — چون atomic بودن تراکنش‌ها تضمین می‌کند که همه یا هیچ.  &lt;b&gt;کاربردهای مجاز:&lt;/b&gt; ۱. آربیتراژ بین DEXها — گرفتن وام، خرید از یک DEX، فروش در DEX دیگر، بازپرداخت ۲. Refinancing — انتقال وام از یک پلتفرم به پلتفرم دیگر با نرخ بهتر ۳. Collateral Swap — تغییر وثیقه از ETH به WBTC بدون نیاز به سرمایه اضافی ۴. Self-liquidation — جلوگیری از Liquidation Penalty با تصفیه خودکار  &lt;b&gt;کاربردهای مخرب (حملات):&lt;/b&gt; • Flash Loan Attacks — دستکاری قیمت اوراکل با سرمایه عظیم    مثال: حمله به bZx (۲۰۲۰)، Cream Finance، Beanstalk • Harvest Attack — دستکاری قیمت توکن yield، برداشت سود، بازگشت قیمت  &lt;b&gt;راه‌حل‌ها:&lt;/b&gt; • استفاده از TWAP Oracles (به جای spot) • Multi-oracle sources • Circuit breakers — توقف در صورت تغییر شدید قیمت • Commit-reveal schemes" vertex="1">
          <mxGeometry height="220" width="2400" x="320" y="30111" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-181" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b4e7c8;strokeColor=#588878;fontColor=#1f4a3c;fontSize=14;fontStyle=1;" value="مدل‌های نرخ بهره — چگونه نرخ تعیین می‌شود؟" vertex="1">
          <mxGeometry height="40" width="2400" x="320" y="30571" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-182" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b4e7c8;strokeColor=#588878;fontColor=#1f4a3c;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="Utilization Rate (UR)  نسبت سپرده‌های قرض‌گرفته‌شده به کل سپرده‌ها. UR = Total Borrows / Total Supplies اگر UR بالا → تقاضای زیاد → نرخ بهره بالا" vertex="1">
          <mxGeometry height="200" width="580" x="320" y="30621" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-183" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b4e7c8;strokeColor=#588878;fontColor=#1f4a3c;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="Compound Model  نرخ خطی تا یک kink (مثلاً ۸۰٪)، سپس نرخ شیب‌دار. تا ۸۰٪: نرخ آرام بعد ۸۰٪: نرخ تند بالا می‌رود (جریمه برای استفاده بیش از حد)" vertex="1">
          <mxGeometry height="200" width="580" x="920" y="30621" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-184" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b4e7c8;strokeColor=#588878;fontColor=#1f4a3c;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="Aave V3 Model  دو نرخ: متغیر (Floating) و ثابت (Stable). نرخ متغیر هر بلوک تغییر می‌کند نرخ ثابت برای مدت زمانی مشخص تثبیت می‌شود" vertex="1">
          <mxGeometry height="200" width="580" x="1520" y="30621" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-185" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b4e7c8;strokeColor=#588878;fontColor=#1f4a3c;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="Yield Curve  در DeFi سنتی yield curve وجود ندارد. اما پروتکل‌های جدید (مثل Pendle) این مفهوم را با tokenizing future yields معرفی می‌کنند." vertex="1">
          <mxGeometry height="200" width="580" x="2120" y="30621" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-186" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#1f2937;strokeColor=#111827;fontColor=#ffffff;fontSize=16;fontStyle=1;" value="۸. Yield Farming، Liquidity Mining و استراتژی‌های بازده" vertex="1">
          <mxGeometry height="44" width="2400" x="320" y="30901" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-187" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5d6e6;strokeColor=#b54ba0;fontColor=#5a1f4e;fontSize=11;" value="Yield Farming (کشاورزی بازده) فرآیند بهینه‌سازی بازده سرمایه با جابجایی دارایی بین پروتکل‌های مختلف DeFi است. کاربران دارایی‌هایشان را در پروتکل‌هایی که بیشترین بازده را ارائه می‌دهند سپرده‌گذاری می‌کنند، و ممکن است به طور همزمان از چندین منبع درآمد سود ببرند. این یکی از مهم‌ترین پدیده‌های DeFi است که از سال ۲۰۲۰ با «Summer of DeFi» آغاز شد." vertex="1">
          <mxGeometry height="100" width="2400" x="320" y="30961" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-188" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5d6e6;strokeColor=#b54ba0;fontColor=#5a1f4e;fontSize=14;fontStyle=1;" value="منابع بازده در DeFi" vertex="1">
          <mxGeometry height="40" width="2400" x="320" y="31081" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-189" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5d6e6;strokeColor=#b54ba0;fontColor=#5a1f4e;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="۱. Trading Fees  کمیسیون معاملات در DEXها. کارمزد هر معامله (۰.۰۵٪ تا ۱٪) به نقدینگی‌دهندگان تعلق می‌گیرد. منبع اصلی درآمد AMMها." vertex="1">
          <mxGeometry height="110" width="780" x="320" y="31131" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-190" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5d6e6;strokeColor=#b54ba0;fontColor=#5a1f4e;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="۲. Lending Interest  سود وام‌دهی در پروتکل‌هایی مثل Aave و Compound. نرخ متغیر بر اساس عرضه و تقاضا. معمولاً ۲-۱۵٪ APY." vertex="1">
          <mxGeometry height="110" width="780" x="1120" y="31131" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-191" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5d6e6;strokeColor=#b54ba0;fontColor=#5a1f4e;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="۳. Protocol Tokens  پاداش توکن پروتکل برای استفاده (Liquidity Mining). مثال: UNI، COMP، CRV. این «Yield» واقعی نیست — سوبسید است." vertex="1">
          <mxGeometry height="110" width="780" x="1920" y="31131" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-192" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5d6e6;strokeColor=#b54ba0;fontColor=#5a1f4e;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="۴. Staking Rewards  سود استیک کردن توکن‌ها برای امنیت شبکه. مثال: ETH staking ۲-۵٪، SOL staking ۶-۸٪، ADA staking ۴-۶٪." vertex="1">
          <mxGeometry height="110" width="780" x="320" y="31261" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-193" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5d6e6;strokeColor=#b54ba0;fontColor=#5a1f4e;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="۵. Liquid Staking (LSD)  سود استیک + قابلیت معامله توکن مشتقه. stETH، rETH، cbETH. معمولاً ۳-۵٪ روی ETH." vertex="1">
          <mxGeometry height="110" width="780" x="1120" y="31261" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-194" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5d6e6;strokeColor=#b54ba0;fontColor=#5a1f4e;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="۶. Restaking  استیک مجدد توکن‌های استیک‌شده برای امنیت سرویس‌های دیگر. EigenLayer اجازه می‌دهد ETH استیک‌شده برای AVSها استفاده شود." vertex="1">
          <mxGeometry height="110" width="780" x="1920" y="31261" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-195" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5d6e6;strokeColor=#b54ba0;fontColor=#5a1f4e;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="۷. Real World Assets (RWA)  سود از دارایی‌های دنیای واقعی: اوراق قرضه خزانه‌داری آمریکا، وام‌های مسکن، صورتحساب‌ها. توسط MakerDAO، Ondo، Centrifuge." vertex="1">
          <mxGeometry height="110" width="780" x="320" y="31391" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-196" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5d6e6;strokeColor=#b54ba0;fontColor=#5a1f4e;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="۸. Strategy Vaults  استراتژی‌های خودکار در Yearn، Beefy، Harvest که به طور خودکار دارایی‌ها را بین پروتکل‌ها جابجا می‌کنند." vertex="1">
          <mxGeometry height="110" width="780" x="1120" y="31391" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-197" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5d6e6;strokeColor=#b54ba0;fontColor=#5a1f4e;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="۹. Native Yield  بازده ذاتی بلاکچین‌ها. مثال: Berachain (BGT)، Mode Network، Blast — بازده از کارمزد L2 یا气体 به کاربران بازمی‌گردد." vertex="1">
          <mxGeometry height="110" width="780" x="1920" y="31391" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-198" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=14;fontStyle=1;" value="ریسک‌های Yield Farming" vertex="1">
          <mxGeometry height="40" width="2400" x="320" y="31541" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-199" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Smart Contract Risk  باگ در قرارداد هوشمند → از دست رفتن کامل سرمایه. مثال: حمله به Cream Finance ($130M)، Harvest Finance ($24M)." vertex="1">
          <mxGeometry height="130" width="580" x="320" y="31591" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-200" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Impermanent Loss  تغییر قیمت نسبی توکن‌ها در استخر → زیان. می‌تواند تمام بازده را بخورد یا بیشتر. بزرگ‌ترین ریسک LP." vertex="1">
          <mxGeometry height="130" width="580" x="920" y="31591" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-201" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Liquidation Risk  اگر از وام برای اهرم استفاده شود، افت بازار می‌تواند به تصفیه منجر شود. ضرر ترکیبی از IL + Liquidation." vertex="1">
          <mxGeometry height="130" width="580" x="1520" y="31591" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-202" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Token Inflation  پاداش توکن پروتکل باعث تورم می‌شود — قیمت توکن افت می‌کند و ارزش واقعی پاداش کاهش می‌یابد. «Yield» واقعی نیست." vertex="1">
          <mxGeometry height="130" width="580" x="2120" y="31591" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-203" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Oracle Manipulation  حملات Flash Loan به اوراکل‌ها می‌تواند قیمت‌ها را دستکاری کند و باعث تصفیه نادرست یا برداشت سود کاذب شود." vertex="1">
          <mxGeometry height="130" width="580" x="320" y="31741" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-204" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Rug Pull  تیم پروژه سرمایه‌ها را فراری می‌دهد. در پروژه‌های ناشناس شایع. به خصوص در memecoinها و استخرهای با بازده غیرمنطقی (&gt;۱۰۰۰٪)." vertex="1">
          <mxGeometry height="130" width="580" x="920" y="31741" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-205" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Composability Risk  پروتکل A روی B تکیه می‌کند، B روی C. اگر C مشکل پیدا کند، A و B هم مختل می‌شوند. زنجیره وابستگی." vertex="1">
          <mxGeometry height="130" width="580" x="1520" y="31741" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-206" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Regulatory Risk  تغییر قوانین می‌تواند پروتکل را مجبور به توقف یا مسدود کردن کاربران کند. مثال: Tornado Cash sanctions، SEC vs.Uniswap." vertex="1">
          <mxGeometry height="130" width="580" x="2120" y="31741" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-207" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5d6e6;strokeColor=#b54ba0;fontColor=#5a1f4e;fontSize=14;fontStyle=1;" value="مثال استراتژی‌های Yield Farming" vertex="1">
          <mxGeometry height="40" width="2400" x="320" y="31911" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-208" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5d6e6;strokeColor=#b54ba0;fontColor=#5a1f4e;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Simple Staking  استیک USDC در Aave. بازده: ۵-۸٪ APY. ریسک: بسیار پایین." vertex="1">
          <mxGeometry height="140" width="760" x="320" y="31961" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-209" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5d6e6;strokeColor=#b54ba0;fontColor=#5a1f4e;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="LP + Farming  ایجاد LP در Uniswap، سپس LP token را در farm سپرده‌گذاری. بازده: ۲۰-۱۰۰٪ APY. ریسک: IL + smart contract." vertex="1">
          <mxGeometry height="140" width="760" x="1100" y="31961" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-210" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5d6e6;strokeColor=#b54ba0;fontColor=#5a1f4e;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Leveraged Staking  استیک ETH → stETH → وام گرفتن ETH در Aave → استیک مجدد. بازده ترکیبی ۱۰-۱۵٪. ریسک: Liquidation." vertex="1">
          <mxGeometry height="140" width="760" x="1880" y="31961" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-211" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5d6e6;strokeColor=#b54ba0;fontColor=#5a1f4e;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Delta-Neutral  Long ETH در Spot + Short ETH در Perp. سود از funding rate. ریسک: funding rate variable، liquidation ریسک." vertex="1">
          <mxGeometry height="140" width="760" x="320" y="32121" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-212" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5d6e6;strokeColor=#b54ba0;fontColor=#5a1f4e;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Real Yield  LP در استخرهای با کارمزد واقعی (مثل GMX، GNS). توزیع سود در ETH. بازده: ۱۰-۳۰٪. ریسک: پایین‌تر." vertex="1">
          <mxGeometry height="140" width="760" x="1100" y="32121" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-213" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5d6e6;strokeColor=#b54ba0;fontColor=#5a1f4e;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Restaking Loop  ETH → stETH (Lido) → restake در EigenLayer → AVS rewards. بازده ترکیبی ۵-۱۰٪ + slash risk." vertex="1">
          <mxGeometry height="140" width="760" x="1880" y="32121" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-214" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#1f2937;strokeColor=#111827;fontColor=#ffffff;fontSize=16;fontStyle=1;" value="۹. زیرساخت DeFi — Oracles، Bridges و Layer 2" vertex="1">
          <mxGeometry height="44" width="2400" x="320" y="32361" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-215" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0e2d0;strokeColor=#a07a4f;fontColor=#4a3520;fontSize=14;fontStyle=1;" value="Oracles — پل بین بلاکچین و دنیای واقعی" vertex="1">
          <mxGeometry height="40" width="2400" x="320" y="32421" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-216" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0e2d0;strokeColor=#a07a4f;fontColor=#4a3520;fontSize=11;" value="قراردادهای هوشمند نمی‌توانند مستقیماً به داده‌های خارج از بلاکچین دسترسی داشته باشند (قانون sandbox). Oracles سرویس‌هایی هستند که این داده‌ها (قیمت‌ها، رویدادهای ورزشی، آب‌وهوا، داده‌های بانکی) را به صورت قابل تأیید به بلاکچین می‌آورند. اما اوراکل خودش مرکزیتی است — اگر منبع داده دستکاری شود، کل سیستم به خطر می‌افتد. این مشکل «Oracle Problem» نام دارد." vertex="1">
          <mxGeometry height="80" width="2400" x="320" y="32471" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-217" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0e2d0;strokeColor=#a07a4f;fontColor=#4a3520;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Chainlink  بزرگ‌ترین oracle network. استفاده از node operators متعدد، aggregation روش‌های مختلف، OCR (Off-Chain Reporting). پشتیبانی از قیمت، random number (VRF)، computation، proof of reserve." vertex="1">
          <mxGeometry height="110" width="780" x="320" y="32561" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-218" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0e2d0;strokeColor=#a07a4f;fontColor=#4a3520;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Pyth Network  اکوسیستم هرمی — data providers اولیه (مثل صرافی‌ها) داده‌ها را به طور مستقیم publish می‌کنند. سرعت بالا، قیمت‌های دقیق‌تر." vertex="1">
          <mxGeometry height="110" width="780" x="1120" y="32561" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-219" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0e2d0;strokeColor=#a07a4f;fontColor=#4a3520;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="API3  First-party oracles — خود API provider node را اجرا می‌کند. حذف  واسطه. API3 token برای insurance pool." vertex="1">
          <mxGeometry height="110" width="780" x="1920" y="32561" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-220" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0e2d0;strokeColor=#a07a4f;fontColor=#4a3520;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="UMA Optimistic Oracle  مدل optimistic — یک side قرار میده، اگر کسی در زمان چالش نکند، تأیید می‌شود. مناسب برای داده‌های پیچیده." vertex="1">
          <mxGeometry height="110" width="780" x="320" y="32691" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-221" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0e2d0;strokeColor=#a07a4f;fontColor=#4a3520;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="MakerDAO Oracles  فدراسیون ۱۴-۲۶ feed + Medianizer + OSM (تأخیر ۱ ساعته). توضیح داده شد در بخش MakerDAO." vertex="1">
          <mxGeometry height="110" width="780" x="1120" y="32691" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-222" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0e2d0;strokeColor=#a07a4f;fontColor=#4a3520;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="TWAMM / Uniswap TWAP  oracle از داخل بلاکچین — میانگین زمان‌وزن‌دار قیمت استخر AMM. مقاوم در برابر flash loan attacks." vertex="1">
          <mxGeometry height="110" width="780" x="1920" y="32691" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-223" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0e2d0;strokeColor=#a07a4f;fontColor=#4a3520;fontSize=14;fontStyle=1;" value="Bridges — پل بین بلاکچین‌های مختلف" vertex="1">
          <mxGeometry height="40" width="2400" x="320" y="32851" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-224" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;" value="پل‌ها اجازه انتقال دارایی و پیام بین بلاکچین‌های مختلف را می‌دهند. مثلاً تبدیل ETH در Ethereum به ETH در Arbitrum. اما پل‌ها خطرناک‌ترین بخش DeFi هستند — بیشترین هک‌ها در این بخش رخ داده. هر پل یک نقطه مرکزی است." vertex="1">
          <mxGeometry height="70" width="2400" x="320" y="32901" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-225" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0e2d0;strokeColor=#a07a4f;fontColor=#4a3520;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Lock &amp; Mint  دارایی در زنجیره مبدأ قفل می‌شود، توکن wrapped در زنجیره مقصد صادر می‌شود. مثال: Portal (Wormhole)، Multichain (anyswap). خطر: امنیت قرارداد قفل." vertex="1">
          <mxGeometry height="120" width="780" x="320" y="32981" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-226" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0e2d0;strokeColor=#a07a4f;fontColor=#4a3520;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Liquidity Pools  دارایی‌ها در استخرهای دو طرف پل نگهداری می‌شوند. کاربران swap می‌کنند. مثال: Stargate، Across. مزیت: سریع. عیب: نیاز به LP." vertex="1">
          <mxGeometry height="120" width="780" x="1120" y="32981" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-227" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0e2d0;strokeColor=#a07a4f;fontColor=#4a3520;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Burn &amp; Mint  دارایی در مبدأ سوزانده، در مقصد ضرب می‌شود. مثال: LayerZero، Nomad. مزیت: بدون نیاز به liquidity. عیب: نیاز به هماهنگی consensus." vertex="1">
          <mxGeometry height="120" width="780" x="1920" y="32981" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-228" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0e2d0;strokeColor=#a07a4f;fontColor=#4a3520;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Validator Bridges  گروهی از validators انتقال را تأیید می‌کنند. مثال: Wormhole (19 guardians). خطر: اگر ۱۳ guardian از ۱۹ سازند، می‌توانند هر چیزی را منتقل کنند." vertex="1">
          <mxGeometry height="120" width="780" x="320" y="33121" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-229" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0e2d0;strokeColor=#a07a4f;fontColor=#4a3520;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Light Client Bridges  تأیید هدرهای زنجیره مبدأ در زنجیره مقصد. امن‌ترین اما کند. مثال: IBC (Cosmos)، Snowbridge." vertex="1">
          <mxGeometry height="120" width="780" x="1120" y="33121" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-230" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0e2d0;strokeColor=#a07a4f;fontColor=#4a3520;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="NFT Bridges  مخصوص NFTها. مثال: Wormhole NFT، LayerZero ONFT." vertex="1">
          <mxGeometry height="120" width="780" x="1920" y="33121" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-231" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0e2d0;strokeColor=#a07a4f;fontColor=#4a3520;fontSize=14;fontStyle=1;" value="Layer 2 Solutions — راه‌حلی برای مقیاس‌پذیری Ethereum" vertex="1">
          <mxGeometry height="40" width="2400" x="320" y="33291" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-232" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fafafa;strokeColor=#aaaaaa;fontColor=#555555;fontSize=11;" value="Ethereum محدودیت پردازش دارد (~۱۵ TPS) و کارمزد بالاست. Layer 2 راه‌حل: پردازش تراکنش‌ها در زنجیره‌های جداگانه، اما امنیت از Ethereum اصلی (L1) تأمین می‌شود. این اکوسیستم غنی DeFi روی L2ها ساخته شده." vertex="1">
          <mxGeometry height="70" width="2400" x="320" y="33341" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-233" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0e2d0;strokeColor=#a07a4f;fontColor=#4a3520;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Optimistic Rollups  فرض: تراکنش‌ها معتبر هستند. اگر کسی چالش کند، fraud proof اجرا می‌شود. • Arbitrum (One, Nova, Stylus) — TVL: ~$15B • Optimism (Mainnet, Base، Mode) — TVL: ~$8B •withdrawals: ۷ روز (challenge period)" vertex="1">
          <mxGeometry height="150" width="780" x="320" y="33421" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-234" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0e2d0;strokeColor=#a07a4f;fontColor=#4a3520;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="ZK Rollups  اثبات ریاضی با zero-knowledge proofs. هر batch دارای validity proof. • zkSync Era — TVL: ~$1B • Starknet — TVL: ~$300M • Linea، Scroll، Polygon zkEVM •withdrawals: سریع (دقیقه)" vertex="1">
          <mxGeometry height="150" width="780" x="1120" y="33421" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-235" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0e2d0;strokeColor=#a07a4f;fontColor=#4a3520;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Validium  مثل ZK Rollup اما data availability خارج از زنجیره. • zkSync Porter، Polygon Miden • کارمزد کمتر اما ریسک data withholding" vertex="1">
          <mxGeometry height="150" width="780" x="1920" y="33421" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-236" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0e2d0;strokeColor=#a07a4f;fontColor=#4a3520;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Volition (Hybrid)  ترکیب Rollup و Validium — کاربر انتخاب می‌کند. • zkSync Era (post-Boojum)" vertex="1">
          <mxGeometry height="150" width="780" x="320" y="33591" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-237" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0e2d0;strokeColor=#a07a4f;fontColor=#4a3520;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Sidechains  زنجیره مستقل با共识 خود — امنیت جدا از L1. • Polygon PoS — TVL: ~$1B • Gnosis Chain،BNB Smart Chain • سریع‌تر اما امنیت کمتر از Rollups" vertex="1">
          <mxGeometry height="150" width="780" x="1120" y="33591" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-238" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0e2d0;strokeColor=#a07a4f;fontColor=#4a3520;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="AppChains  زنجیره‌های اختصاصی برای یک dApp. • dYdX v4 (Cosmos)، Osmosis، Aevo • کنترل کامل، کنترل کارمزد، حاکمیت مستقل" vertex="1">
          <mxGeometry height="150" width="780" x="1920" y="33591" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-239" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#1f2937;strokeColor=#111827;fontColor=#ffffff;fontSize=16;fontStyle=1;" value="۱۰. مفاهیم پیشرفته DeFi — MEV، LSD، Restaking و Composability" vertex="1">
          <mxGeometry height="44" width="2400" x="320" y="33841" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-240" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=14;fontStyle=1;" value="MEV — Maximal Extractable Value — ارزش قابل استخراج" vertex="1">
          <mxGeometry height="40" width="2400" x="320" y="33901" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-241" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;" value="MEV ارزشی است که بلاک‌سازها (miners/validators) می‌توانند با بازچینش، اضافه یا حذف تراکنش‌ها در یک بلوک استخراج کنند. MEV هم قانونی است (آربیتراژ) و هم مخرب (sandwich attacks). سالانه صدها میلیون دلار MEV از کاربران استخراج می‌شود." vertex="1">
          <mxGeometry height="80" width="2400" x="320" y="33951" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-242" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Sandwich Attack  Front-run + back-run یک معامله بزرگ. attacker معامله کاربر را می‌بیند، قبل از آن خرید می‌کند (قیمت را بالا می‌برد)، معامله کاربر با قیمت بالاتر اجرا می‌شود، سپس attacker می‌فروشد. کاربر متضرر، attacker سود می‌کند." vertex="1">
          <mxGeometry height="130" width="780" x="320" y="34041" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-243" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Arbitrage  استخراج سود از اختلاف قیمت بین DEXها. مثلاً ETH در Uniswap ۲۰۰۰$ اما در Sushi ۲۰۱۰$ — خرید از Uni، فروش در Sushi. این نوع MEV مفید است (به بازار کارایی می‌بخشد)." vertex="1">
          <mxGeometry height="130" width="780" x="1120" y="34041" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-244" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Liquidation  بازارسازان بات‌ها فوراً وام‌های ناسالم را تصفیه می‌کنند تا پاداش بگیرند. رقابت شدید — اولین keeper برنده است. Pareto distribution — چند برنده بزرگ." vertex="1">
          <mxGeometry height="130" width="780" x="1920" y="34041" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-245" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="JIT Liquidity  Just-In-Time liquidity — attacker لحظه‌ای قبل از یک معامله بزرگ، نقدینگی به استخر اضافه می‌کند، کارمزد می‌گیرد، سپس برمی‌دارد. برای LPهای معمولی مضر." vertex="1">
          <mxGeometry height="130" width="780" x="320" y="34191" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-246" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Long-tail MEV  استراتژی‌های پیچیده‌تر: NFT sniping، airdrop farming، DAO voting manipulation.  searcher bots به طور مداوم الگوهای جدید می‌یابند." vertex="1">
          <mxGeometry height="130" width="780" x="1120" y="34191" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-247" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Back-running  قرار دادن تراکنش بلافاصله پس از یک رویداد مهم (مثل liquidation یا قیمت بزرگ). کمترین آسیب، بیشترین سود. اکثراً توسط MEV-Boost relays استفاده می‌شود." vertex="1">
          <mxGeometry height="130" width="780" x="1920" y="34191" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-248" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5d6e6;strokeColor=#b54ba0;fontColor=#5a1f4e;fontSize=14;fontStyle=1;" value="راه‌حل‌های MEV — کاهش آسیب به کاربران" vertex="1">
          <mxGeometry height="40" width="2400" x="320" y="34371" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-249" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5d6e6;strokeColor=#b54ba0;fontColor=#5a1f4e;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="MEV-Boost  استاندارد PBS (Proposer-Builder Separation) در Ethereum. validators بلوک‌های آماده‌شده توسط builders را انتخاب می‌کنند. سود MEV به stakers می‌رسد." vertex="1">
          <mxGeometry height="110" width="780" x="320" y="34421" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-250" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5d6e6;strokeColor=#b54ba0;fontColor=#5a1f4e;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Flashbots Protect  سرویس رایگان برای کاربران — تراکنش‌ها به جای mempool عمومی، به private relays می‌رود. محافظت در برابر sandwich attacks." vertex="1">
          <mxGeometry height="110" width="780" x="1120" y="34421" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-251" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5d6e6;strokeColor=#b54ba0;fontColor=#5a1f4e;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="CowSwap   Batch auction — معاملات هم‌زمان گروه‌بندی و در یک قیمت واحد اجرا می‌شوند. CoW = Coincidence of Wants. حذف نیاز به AMM برای معاملات متقابل." vertex="1">
          <mxGeometry height="110" width="780" x="1920" y="34421" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-252" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5d6e6;strokeColor=#b54ba0;fontColor=#5a1f4e;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="1inch Fusion  کاربر سفارش می‌دهد، resolvers (که ریسک MEV را می‌پذیرند) آن را اجرا می‌کنند. کاربر از sandwich در امان است، resolver سود MEV را به عنوان کارمزد می‌گیرد." vertex="1">
          <mxGeometry height="110" width="780" x="320" y="34551" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-253" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5d6e6;strokeColor=#b54ba0;fontColor=#5a1f4e;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Uniswap X  مدل Dutch auction برای سفارش‌ها. سفارش به طور تدریجی قیمت بدتر می‌کند تا fillers پیدا شوند. محافظت در برابر MEV + قیمت بهتر." vertex="1">
          <mxGeometry height="110" width="780" x="1120" y="34551" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-254" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5d6e6;strokeColor=#b54ba0;fontColor=#5a1f4e;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Threshold Encryption  رمزگذاری تراکنش‌ها تا زمان inclusion — validator نمی‌تواند محتوا ببیند. هنوز آزمایشی (مثل Shutter Network)." vertex="1">
          <mxGeometry height="110" width="780" x="1920" y="34551" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-255" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5d6e6;strokeColor=#b54ba0;fontColor=#5a1f4e;fontSize=14;fontStyle=1;" value="Liquid Staking Derivatives (LSD) و Restaking" vertex="1">
          <mxGeometry height="40" width="2400" x="320" y="34711" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-256" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5d6e6;strokeColor=#b54ba0;fontColor=#5a1f4e;fontSize=11;" value="Liquid Staking یکی از مهم‌ترین نوآوری‌های اخیر DeFi است. وقتی ETH را برای امنیت Ethereum استیک می‌کنید، معمولاً تا Shanghai upgrade قفل بود. LSD این مشکل را حل کرد — شما توکن مشتقه (مثل stETH) دریافت می‌کنید که نماینده ETH استیک‌شده + سود انباشته است و قابل معامله، استفاده در DeFi، یا حتی استیک مجدد است." vertex="1">
          <mxGeometry height="80" width="2400" x="320" y="34761" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-257" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5d6e6;strokeColor=#b54ba0;fontColor=#5a1f4e;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Lido (stETH)  بزرگ‌ترین LSD provider. ~۳۰٪ کل ETH استیک‌شده. stETH به طور روزانه rebase می‌شود (سود اضافه می‌شود). پشتیبانی از staked MATIC، SOL، و غیره." vertex="1">
          <mxGeometry height="130" width="780" x="320" y="34851" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-258" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5d6e6;strokeColor=#b54ba0;fontColor=#5a1f4e;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Rocket Pool (rETH)  غیرمتمرکزترین — هر节点 می‌تواند node operator باشد. rETH نسبت ETH را به طور زمانی افزایش می‌دهد (نه rebase). حداقل ۸ ETH برای operator." vertex="1">
          <mxGeometry height="130" width="780" x="1120" y="34851" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-259" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5d6e6;strokeColor=#b54ba0;fontColor=#5a1f4e;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Coinbase (cbETH)  LSD متمرکز توسط Coinbase. مناسب کاربران نهادی. به但其 شفافیت کمتر از Lido/Rocket Pool. معافیت تنظیمی American users." vertex="1">
          <mxGeometry height="130" width="780" x="1920" y="34851" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-260" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5d6e6;strokeColor=#b54ba0;fontColor=#5a1f4e;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Frax (frxETH/sfrxETH)  Duel-token model. frxETH پگ‌شده به ETH، sfrxETH نسخه stake‌شده با سود. انعطاف‌پذیر برای DeFi." vertex="1">
          <mxGeometry height="130" width="780" x="320" y="35001" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-261" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5d6e6;strokeColor=#b54ba0;fontColor=#5a1f4e;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="EigenLayer (Restaking)  پلتفرم restaking — اجازه می‌دهد ETH استیک‌شده (LST) برای تأمین امنیت سرویس‌های دیگر (AVS — Actively Validated Services) استفاده شود. سود اضافی در عین ریسک slashing." vertex="1">
          <mxGeometry height="130" width="780" x="1120" y="35001" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-262" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5d6e6;strokeColor=#b54ba0;fontColor=#5a1f4e;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Liquid Restaking (LRT)  نسل بعد — توکن‌سازی restaked position. مثال: ether.fi (eETH)، Renzo (ezETH)، Kelp (rsETH). کاربران می‌توانند LRT را در DeFi استفاده کنند." vertex="1">
          <mxGeometry height="130" width="780" x="1920" y="35001" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-263" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7a5d0a;fontSize=14;fontStyle=1;" value="Composability — Money Legos — ترکیب‌پذیری پروتکل‌ها" vertex="1">
          <mxGeometry height="40" width="2400" x="320" y="35181" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-264" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7a5d0a;fontSize=11;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;" value="Composability یکی از قدرتمندترین ویژگی‌های DeFi است — پروتکل‌ها می‌توانند مانند قطعات لگو روی هم قرار گیرند و ترکیب شوند. این ویژگی در مالی سنتی وجود ندارد.  &lt;b&gt;مثال‌های Composability:&lt;/b&gt; • Yearn استفاده می‌کند از: Aave + Compound + Curve + Uniswap • CowSwap استفاده می‌کند از: Uniswap + Sushi + Curve + Balancer (بهترین قیمت) • MakerDAO D3M استفاده می‌کند از: Aave (مستقیم DAI را به Aave تزریق می‌کند) • Lido stETH استفاده می‌کند در: Curve (stETH/ETH pool)، Aave (collateral)، MakerDAO • EigenLayer استفاده می‌کند از: stETH، cbETH، rETH (هر LSD)  &lt;b&gt;مزایا:&lt;/b&gt; نوآوری سریع، سرویس‌های پیچیده، رقابت، بهره‌وری سرمایه.  &lt;b&gt;ریسک‌ها:&lt;/b&gt; • Systemic Risk — مشکل در یک پروتکل پایه (مثل Chainlink) به همه سرایت می‌کند • Cascading Liquidations — افت بازار → تصفیه‌های زنجیره‌ای → افت بیشتر • Governance Attacks — کنترل یک پروتکل کوچک ممکن است به کنترل پروتکل‌های بزرگ منجر شود • Hidden Dependencies — وابستگی‌های پنهان که در بحران آشکار می‌شوند" vertex="1">
          <mxGeometry height="132" width="2400" x="320" y="35231" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-265" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#1f2937;strokeColor=#111827;fontColor=#ffffff;fontSize=16;fontStyle=1;" value="۱۱. امنیت و حوادث بزرگ DeFi — درس‌هایی از تاریخ" vertex="1">
          <mxGeometry height="44" width="2400" x="320" y="35691" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-266" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=14;fontStyle=1;" value="انواع حملات رایج در DeFi" vertex="1">
          <mxGeometry height="40" width="2400" x="320" y="35751" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-267" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Reentrancy  قرارداد مهاجم، در حین اجرای تابع قرارداد قربانی، دوباره آن را فراخوانی می‌کند. کلاسیک‌ترین حمله — The DAO hack (2016). راه‌حل: CEI pattern، ReentrancyGuard." vertex="1">
          <mxGeometry height="120" width="780" x="320" y="35801" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-268" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Flash Loan Attack  گرفتن وام عظیم بدون وثیقه، دستکاری قیمت اوراکل، کسب سود، بازپرداخت — همه در یک تراکنش. مثال: bZx (2020)، Cream Finance، Beanstalk ($182M)." vertex="1">
          <mxGeometry height="120" width="780" x="1120" y="35801" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-269" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Oracle Manipulation  دستکاری منبع قیمت — معمولاً با استفاده از استخرهای نقدینگی کم. قیمت کاذب باعث تصفیه نادرست یا وام بیش از حد می‌شود." vertex="1">
          <mxGeometry height="120" width="780" x="1920" y="35801" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-270" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Price Oracle Latency  استفاده از قیمت قدیمی (stale price) — اگر oracle آپدیت نشده باشد. مثال: Venus protocol on BSC — $100M+ liquidation نادرست." vertex="1">
          <mxGeometry height="120" width="780" x="320" y="35941" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-271" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Smart Contract Bug  باگ در کد قرارداد — overflow/underflow، access control، logic errors. مثال: Parity wallet multisig ($280M freeze)، Wormhole ($326M)." vertex="1">
          <mxGeometry height="120" width="780" x="1120" y="35941" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-272" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Bridge Hack  بیشترین هک‌ها — پل‌ها نقطه مرکزی هستند. مثال: Ronin ($625M)، Wormhole ($326M)، Nomad ($190M)، Poly Network ($611M)." vertex="1">
          <mxGeometry height="120" width="780" x="1920" y="35941" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-273" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Governance Attack  گرفتن کنترل حاکمیت با خرید توکن یا flash loan. مثال: Beanstalk ($182M) — attacker با وام، اکثریت توکن را گرفت و propose مخرب را پاس کرد." vertex="1">
          <mxGeometry height="120" width="780" x="320" y="36081" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-274" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Front-running / MEV  ساندویچ اکسپلویت — تراکنش کاربر را می‌بینند، قبل و بعد از آن معامله می‌کنند. سالانه صدها میلیون از کاربران استخراج می‌شود." vertex="1">
          <mxGeometry height="120" width="780" x="1120" y="36081" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-275" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value=" rug Pull  تیم پروژه سرمایه کاربران را فراری می‌دهد. در memecoinها و پروژه‌های ناشناس شایع. مثال: Squid Game token، Thodex." vertex="1">
          <mxGeometry height="120" width="780" x="1920" y="36081" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-276" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=14;fontStyle=1;" value="حوادث بزرگ DeFi — خط زمانی" vertex="1">
          <mxGeometry height="40" width="2400" x="320" y="36241" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-277" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" value="۲۰۱۶ — The DAO  گرفته شد: $60M ETH حمله Reentrancy. باعث هاردفورک Ethereum → ETH و ETC." vertex="1">
          <mxGeometry height="160" width="290" x="320" y="36291" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-278" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" value="۲۰۲۰ — bZx  گرفته شد: $1M اولین Flash Loan Attack معروف. دو حمله در ۲۴ ساعت." vertex="1">
          <mxGeometry height="160" width="290" x="615" y="36291" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-279" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" value="۲۰۲۰ — Harvest Finance  گرفته شد: $24M حمله به استخرهای با قیمت مرتبط (curve manipulation)." vertex="1">
          <mxGeometry height="160" width="290" x="910" y="36291" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-280" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" value="۲۰۲۱ — Poly Network  گرفته شد: $611M (بازگشت داده شد) حمله bridge cross-chain — بزرگ‌ترین تاریخ." vertex="1">
          <mxGeometry height="160" width="290" x="1205" y="36291" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-281" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" value="۲۰۲۲ — Wormhole  گرفته شد: $326M حمله به Solana-Ethereum bridge — signature verification باگ." vertex="1">
          <mxGeometry height="160" width="290" x="1500" y="36291" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-282" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" value="۲۰۲۲ — Ronin Network  گرفته شد: $625M بزرگ‌ترین هک تاریخ. ۹ از ۱۸ validator takeover. Axie Infinity." vertex="1">
          <mxGeometry height="160" width="290" x="1795" y="36291" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-283" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" value="۲۰۲۲ — Beanstalk  گرفته شد: $182M Governance attack با flash loan. در ۹ ثانیه نابود شد." vertex="1">
          <mxGeometry height="160" width="290" x="320" y="36471" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-284" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" value="۲۰۲۲ — Terra/UST  گرفته شد: $60B ( collapse) Death spiral الگوریتمی. بحران سیستمیک DeFi." vertex="1">
          <mxGeometry height="160" width="290" x="615" y="36471" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-285" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" value="۲۰۲۲ — FTX/Alameda  گرفته شد: $8B+ (fraud) صرافی متمرکز اما تأثیر سیستمیک روی DeFi." vertex="1">
          <mxGeometry height="160" width="290" x="910" y="36471" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-286" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" value="۲۰۲۳ — Euler Finance  گرفته شد: $197M (بیشتر بازگشت) Flash loan attack با donations logic bug." vertex="1">
          <mxGeometry height="160" width="290" x="1205" y="36471" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-287" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" value="۲۰۲۳ — Curve  گرفته شد: $70M Vyper compiler bug (reentrancy lock)." vertex="1">
          <mxGeometry height="160" width="290" x="1500" y="36471" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-288" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" value="۲۰۲۴ — Radiant Capital  گرفته شد: $50M Access control + flash loan. روی BSC و Arbitrum." vertex="1">
          <mxGeometry height="160" width="290" x="1795" y="36471" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-289" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=14;fontStyle=1;" value="بهترین شیوه‌های امنیتی در DeFi" vertex="1">
          <mxGeometry height="40" width="2400" x="320" y="36671" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-290" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Audits  ممیزی توسط چندین شرکت مستقل: OpenZeppelin، Trail of Bits، CertiK، ConsenSys Diligence، Sigma Prime. اما audit ضمانت نیست — فقط کاهش ریسک." vertex="1">
          <mxGeometry height="130" width="580" x="320" y="36721" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-291" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Bug Bounties  پاداش یافتن باگ — Immunefi بزرگ‌ترین پلتفرم. تا $10M برای باگ‌های بحرانی. بیشتر از هزینه حمله ارزش دارد." vertex="1">
          <mxGeometry height="130" width="580" x="920" y="36721" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-292" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Formal Verification  اثبات ریاضی درستی قرارداد — مثل Certora Prover. فوق‌العاده گران اما بالاترین ضمانت. استفاده در Aave، Compound، MakerDAO." vertex="1">
          <mxGeometry height="130" width="580" x="1520" y="36721" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-293" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Multi-sig Wallets  کنترل قراردادها توسط کیف پول چندامضا (Gnosis Safe). حداقل ۵ از ۹ signer برای upgrades. جلوگیری از compromise کلید." vertex="1">
          <mxGeometry height="130" width="580" x="2120" y="36721" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-294" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Timelocks  تأخیر زمانی برای اجرای changes — کاربران فرصت withdrawal دارند در صورت upgrade مخرب. معمولاً ۲۴-۷۲ ساعت." vertex="1">
          <mxGeometry height="130" width="580" x="320" y="36871" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-295" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Emergency Actions  Pause mechanism، circuit breaker، emergency shutdown. در صورت حمله، سیستم موقتاً متوقف می‌شود. مثال: Compound pause guardian." vertex="1">
          <mxGeometry height="130" width="580" x="920" y="36871" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-296" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Insurance  بیمه DeFi: Nexus Mutual، InsurAce، Unslashed. پوشش smart contract failure. محدود اما در حال رشد. premiums بالا برای ریسک بالا." vertex="1">
          <mxGeometry height="130" width="580" x="1520" y="36871" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-297" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffd6d6;strokeColor=#cc4444;fontColor=#5a1515;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Risk Management Tools  Chaos Labs، Gauntlet، OpenBlock — شبیه‌سازی سناریوها، تست استرس، parameter optimization. استفاده توسط Aave، Compound." vertex="1">
          <mxGeometry height="130" width="580" x="2120" y="36871" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-298" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#1f2937;strokeColor=#111827;fontColor=#ffffff;fontSize=16;fontStyle=1;" value="۱۲. آینده DeFi — روندها، چالش‌ها و فرصت‌ها" vertex="1">
          <mxGeometry height="44" width="2400" x="320" y="37101" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-299" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d6e2ff;strokeColor=#5a7ac4;fontColor=#1e3a8a;fontSize=11;" value="DeFi در حال گذر از مرحله آزمایشی به بلوغ است. روند اصلی: نهادی‌سازی، تنوع‌بخشی به دارایی‌ها (RWA)، حریم خصوصی، مقیاس‌پذیری L2، و تطابق با تنظیم‌گران. در عین حال، چالش‌های UX، امنیت، و ریسک سیستمیک همچنان پابرجا هستند. این بخش روندهای کلیدی آینده DeFi را بررسی می‌کند." vertex="1">
          <mxGeometry height="100" width="2400" x="320" y="37161" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-300" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d6e2ff;strokeColor=#5a7ac4;fontColor=#1e3a8a;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Real World Assets (RWA)  ترکیب DeFi با دارایی‌های دنیای واقعی: اوراق قرضه خزانه‌داری، وام مسکن، صورتحساب‌ها، املاک. صادرکنندگان: MakerDAO ($3B+ RWA)، Ondo، Centrifuge، Maple، Goldfinch. رشد شدید ۲۰۲۳-۲۰۲۴." vertex="1">
          <mxGeometry height="130" width="580" x="320" y="37271" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-301" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d6e2ff;strokeColor=#5a7ac4;fontColor=#1e3a8a;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Account Abstraction (ERC-4337)  تغییر بنیادی UX — کیف پول‌های قرارداد هوشمند به عنوان پیش‌فرض. gas در توکن‌های دیگر، social recovery، session keys، batched transactions. پایان seed phrase؟" vertex="1">
          <mxGeometry height="130" width="580" x="920" y="37271" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-302" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d6e2ff;strokeColor=#5a7ac4;fontColor=#1e3a8a;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Privacy DeFi  AZTEC، Penumbra، Aleo، Manta Network — تراکنش‌های خصوصی روی DeFi. تعادل بین شفافیت (مزیت بلاکچین) و محرمانگی (مزیت privacy). ZK proofs کلیدی." vertex="1">
          <mxGeometry height="130" width="580" x="1520" y="37271" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-303" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d6e2ff;strokeColor=#5a7ac4;fontColor=#1e3a8a;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Intent-based Architecture  کاربر «نیت» می‌دهد (مثلاً «۱ ETH به USDC با حداقل ۳۰۰۰$»)، solvers بهترین مسیر را پیدا می‌کنند. CowSwap، Uniswap X، 1inch Fusion، Anoma." vertex="1">
          <mxGeometry height="130" width="580" x="2120" y="37271" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-304" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d6e2ff;strokeColor=#5a7ac4;fontColor=#1e3a8a;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Institutional DeFi  بانک‌ها و موسسات وارد DeFi می‌شوند: JPM Coin، Onyx، BlackRock BUIDL ($500M+). اولین tokenized money market fund روی Ethereum. آینده: ترکیب CeFi و DeFi." vertex="1">
          <mxGeometry height="130" width="580" x="320" y="37421" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-305" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d6e2ff;strokeColor=#5a7ac4;fontColor=#1e3a8a;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="DeFi 2.0 / Protocol-owned Liquidity  مدل Olympus DAO — پروتکل‌ها نقدینگی خودشان را می‌خرند به جای استقراض. کاهش تبعیت از farm rewards. روند ۲۰۲۱-۲۰۲۲ که فروکش کرد اما مفهوم باقی ماند." vertex="1">
          <mxGeometry height="130" width="580" x="920" y="37421" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-306" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d6e2ff;strokeColor=#5a7ac4;fontColor=#1e3a8a;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Modular Blockchains  تفکیک لایه‌های execution، settlement، consensus، data availability. Ethereum به settlement layer تبدیل می‌شود. Celestia، EigenDA، Avail برای DA. L2ها برای execution." vertex="1">
          <mxGeometry height="130" width="580" x="1520" y="37421" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-307" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d6e2ff;strokeColor=#5a7ac4;fontColor=#1e3a8a;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Regulatory Compliance  MiCA در اروپا (۲۰۲۴)، GENIUS Act در آمریکا (۲۰۲۴)، Singapore MAS. stablecoin regulation، KYC/AML برای DeFi frontends، sanctions compliance. تنش بین decentralization و compliance." vertex="1">
          <mxGeometry height="130" width="580" x="2120" y="37421" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-308" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d6e2ff;strokeColor=#5a7ac4;fontColor=#1e3a8a;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Cross-chain UX  تجربه‌ای که کاربر زنجیره را حس نمی‌کند. LayerZero، Wormhole، CCIP (Chainlink). Account abstraction + cross-chain = اپلیکیشن‌های واقعی بدون walled gardens." vertex="1">
          <mxGeometry height="130" width="580" x="320" y="37571" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-309" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d6e2ff;strokeColor=#5a7ac4;fontColor=#1e3a8a;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="AI × DeFi  ترکیب AI و DeFi: AI agents که خودکار معامله می‌کنند، AI risk assessment، AI-powered yield strategies. Bittensor (TAO)، Fetch.ai، Autonolas. اما خطرات جدید: model manipulation، AI flash crashes." vertex="1">
          <mxGeometry height="130" width="580" x="920" y="37571" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-310" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d6e2ff;strokeColor=#5a7ac4;fontColor=#1e3a8a;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Tokenization of Everything  سهام، اوراق قرضه، املاک، آثار هنری، حقوقroyalty، intellectual property — همه به صورت توکن. قوانین Howey در آمریکا، MiCA در اروپا چارچوب ایجاد می‌کنند." vertex="1">
          <mxGeometry height="130" width="580" x="1520" y="37571" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-311" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d6e2ff;strokeColor=#5a7ac4;fontColor=#1e3a8a;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="Sustainable Yield  گذار از «yield farming unsustainable» به yield واقعی: RWA، staking rewards، real economic activity. پایان دوره ۱۰۰۰٪ APYهای دروغین. بازده‌های واقعی‌تر اما پایدارتر (۵-۱۵٪)." vertex="1">
          <mxGeometry height="130" width="580" x="2120" y="37571" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-312" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#1f2937;strokeColor=#111827;fontColor=#ffffff;fontSize=16;fontStyle=1;" value="جمع‌بندی: نقشه راه یادگیری DeFi" vertex="1">
          <mxGeometry height="44" width="2400" x="320" y="37751" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-313" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fff8b0;strokeColor=#d6b656;fontColor=#5a4a00;fontSize=12;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;" value="این نقشه ذهنی جامع از مبانی اقتصاد و مالی شروع شد، سپس اجزای اصلی DeFi را پوشش داد، و در نهایت به موضوعات پیشرفته و آینده پرداخت. مسیر پیشنهادی برای یادگیری:  &lt;b&gt;سطح مقدماتی:&lt;/b&gt; مبانی اقتصاد و مالی → استیبل‌کوین‌ها → DEX و AMM → وام‌دهی &lt;b&gt;سطح متوسط:&lt;/b&gt; MakerDAO → Yield Farming → Liquid Staking → Oracles و Bridges &lt;b&gt;سطح پیشرفته:&lt;/b&gt; MEV → Restaking → امنیت و حوادث → روندهای آینده  &lt;b&gt;پیشنهاد عملی:&lt;/b&gt; قبل از سرمایه‌گذاری، هر پروتکل را روی testnet امتحان کنید. با مبالغ کم شروع کنید. چندین منبع را مطالعه کنید (dokumentation، audit reports، governance forums). هرگز در پروژه‌ای که نمی‌فهمید سرمایه‌گذاری نکنید.  DeFi پر از فرصت است اما همچنین پر از ریسک. آموزش بهترین دفاع شماست. این نقشه ذهنی را به عنوان نقطه شروع استفاده کنید — هر بخش را عمیق‌تر مطالعه کنید و با جامعه در تماس باشید." vertex="1">
          <mxGeometry height="92" width="2400" x="320" y="37801" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-314" edge="1" parent="1" source="Tl_rNCZSt6P0KQ3QG7Ih-3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#888888;strokeWidth=1.5;endArrow=classic;endFill=1;" target="Tl_rNCZSt6P0KQ3QG7Ih-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-315" edge="1" parent="1" source="Tl_rNCZSt6P0KQ3QG7Ih-3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#888888;strokeWidth=1.5;endArrow=classic;endFill=1;" target="Tl_rNCZSt6P0KQ3QG7Ih-10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-316" edge="1" parent="1" source="Tl_rNCZSt6P0KQ3QG7Ih-3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#888888;strokeWidth=1.5;endArrow=classic;endFill=1;" target="Tl_rNCZSt6P0KQ3QG7Ih-19">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-333" edge="1" parent="1" source="Tl_rNCZSt6P0KQ3QG7Ih-23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#888888;strokeWidth=1.5;endArrow=classic;endFill=1;" target="Tl_rNCZSt6P0KQ3QG7Ih-24">
