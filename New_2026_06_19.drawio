        <mxCell id="3u3cCtdTfGU9zsH9du92-519" parent="1" style="html=1;whiteSpace=wrap;labelBackgroundColor=none;" value="&lt;b&gt;فرض بر این که فردا قیمت اتریوم دو برابر بشه ما معادل 1/5 دلار اتریوم گذاشته بودیم امروز معادل 3 دلار اتریوم توی این اسمارت کانترکت هست اون دایی که گرفته بودیم رو که رد کردیم رفته الان یک دلار گیرمون اومده یعنی برای این موقعیت ما نیم دلار ذخیره کرده بودیم اگر دای رد کرده&amp;nbsp; باشیم الان توی اسمارت کانترکت 3 دلار ذخیره اس که دای 1 دلار هست 2 دلارش میمونه درواقع ارزش اون موقعیت هست. روز اول نیم دلار گذاشته بودیم الان شده 2 دلار داریم یعنی 4 برابر شده در صورتی که قیمت اتریوم 2 برابر شده انگار موقعیت معاملاتی روی اتریوم داریم که اهرمی هست درجه اهرم متغییر هست که اتریوم ارزی هست که میره بالا قیمتش میریم موقعیتشو میخریم این اتفاق میوفته خیلی نیاز براش زیاد هست روی اتریوم مثبت هستیم و پس یک اهرم میزنیم روی اتریومی که داریم&amp;nbsp;&lt;/b&gt;" vertex="1">
          <mxGeometry height="181" width="281" x="1980" y="19231" as="geometry" />
        </mxCell>
        <mxCell id="3u3cCtdTfGU9zsH9du92-520" parent="1" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;treeFolding=1;treeMoving=1;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;startArrow&quot;:&quot;none&quot;,&quot;endArrow&quot;:&quot;none&quot;};" value="&lt;b&gt;اگر اتریوم افزایشی شود&lt;/b&gt;" vertex="1">
          <mxGeometry height="41" width="100" x="2000" y="19453" as="geometry" />
        </mxCell>
        <mxCell id="3u3cCtdTfGU9zsH9du92-521" edge="1" parent="1" style="edgeStyle=elbowEdgeStyle;elbow=vertical;sourcePerimeterSpacing=0;targetPerimeterSpacing=0;startArrow=none;endArrow=none;rounded=0;curved=0;" target="3u3cCtdTfGU9zsH9du92-520" value="">
