        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#276749;fontSize=10;" value="نقدینگی سرعت تبدیل دارایی به پول نقد. پول نقد = بالاترین نقدینگی" vertex="1">
          <mxGeometry height="90" width="180" x="1130" y="20601" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#276749;fontSize=10;" value="ریسک و بازده سرمایه‌گذاری پرریسک = بازده بالاتر سرمایه‌گذاری کم‌ریسک = بازده پایین‌تر" vertex="1">
          <mxGeometry height="90" width="180" x="1320" y="20601" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#276749;fontSize=11;" value="ابزارهای اصلی مالی: سهام، اوراق قرضه، صندوق‌های سرمایه‌گذاری، مشتقات" vertex="1">
          <mxGeometry height="44" width="560" x="940" y="20701" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#276749;fontSize=11;" value="کاربردهای عملی: زندگی شخصی، کسب‌وکار، سطح ملی" vertex="1">
          <mxGeometry height="40" width="560" x="940" y="20751" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-573" edge="1" parent="1" source="Tl_rNCZSt6P0KQ3QG7Ih-19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="Tl_rNCZSt6P0KQ3QG7Ih-20">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=14;fontStyle=1;" value="مقایسه اقتصاد و مالی" vertex="1">
          <mxGeometry height="44" width="720" x="1560" y="20321" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-570" edge="1" parent="1" source="Tl_rNCZSt6P0KQ3QG7Ih-20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="Tl_rNCZSt6P0KQ3QG7Ih-21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fff8b0;strokeColor=#d6b656;fontColor=#5a4a00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="&lt;b&gt;جنبه&lt;/b&gt; | &lt;b&gt;Economics&lt;/b&gt; | &lt;b&gt;Finance&lt;/b&gt; ---|---|--- &lt;b&gt;دید&lt;/b&gt; | کلان و جامعه | فردی و شرکتی &lt;b&gt;هدف&lt;/b&gt; | توضیح پدیده‌ها | تصمیم‌گیری عملی &lt;b&gt;ابزار&lt;/b&gt; | مدل‌های نظری | محاسبات مالی &lt;b&gt;زمان&lt;/b&gt; | بلندمدت | کوتاه‌/میان‌مدت &lt;b&gt;متغیرها&lt;/b&gt; | تورم، بیکاری، GDP | سود، ریسک، بازده" vertex="1">
          <mxGeometry height="82" width="721" x="1560" y="20422" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-572" edge="1" parent="1" source="Tl_rNCZSt6P0KQ3QG7Ih-21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="Tl_rNCZSt6P0KQ3QG7Ih-22">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fafafa;strokeColor=#aaaaaa;fontColor=#555555;fontSize=11;" value="اقتصاد به ما می‌گوید چه اتفاقی می‌افتد و چرا. مالی می‌گوید چطور از این دانش استفاده کنیم. مالی = اجرای اصول اقتصاد در دنیای واقعی" vertex="1">
          <mxGeometry height="44" width="720" x="1560" y="20561" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-22" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7a5d0a;fontSize=11;" value="اقتصاد زندگی روزمره همه ما را تحت تأثیر قرار می‌دهد. درک اصول اقتصادی به ما کمک می‌کند تا تصمیمات بهتری بگیریم — چه در سطح فردی، چه کسب‌وکار، چه سیاست‌گذاری دولت. مالی غیرمتمرکز (DeFi) همان اصول را در دنیای بلاکچین پیاده‌سازی می‌کند." vertex="1">
          <mxGeometry height="86" width="720" x="1560" y="20665" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-23" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#1f2937;strokeColor=#111827;fontColor=#ffffff;fontSize=16;fontStyle=1;" value="۲. مالی متمرکز (CeFi) در برابر مالی غیرمتمرکز (DeFi)" vertex="1">
          <mxGeometry height="44" width="2400" x="320" y="21011" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-24" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#7c5310;fontSize=14;fontStyle=1;" value="Centralized Finance (CeFi) — مالی متمرکز" vertex="1">
          <mxGeometry height="44" width="560" x="320" y="21081" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-25" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#7c5310;fontSize=11;" value="ویژگی‌های CeFi: • تصمیم‌گیری، کنترل، داده و اعتماد در دست یک یا چند نهاد مرکزی است • توسط مرجع مرکزی انجام می‌شود • داده‌ها در یک یا چند مرکز داده ذخیره می‌شود (مثل AWS) • اعتماد به نهاد مرکزی ضروری است" vertex="1">
          <mxGeometry height="120" width="560" x="320" y="21131" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-26" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#7c5310;fontSize=11;" value="مثال‌ها: AWS، Facebook، Google/Gmail، بانک‌های سنتی، صرافی‌های متمرکز (Binance، Coinbase)" vertex="1">
          <mxGeometry height="60" width="560" x="320" y="21261" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-27" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#7c5310;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;" value="مکانیسم Order Book در CeFi:  Ask (فروش) | Bid (خرید) 100         | 50.00$ 200         | 49.50$ 500         | 49.00$  بازارساز (Market Maker) نقدینگی تأمین می‌کند و از Spread سود می‌برد." vertex="1">
          <mxGeometry height="69" width="560" x="320" y="21331" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-28" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#7c5310;fontSize=14;fontStyle=1;" value="Market Maker و Market Taker" vertex="1">
          <mxGeometry height="44" width="560" x="920" y="21081" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-29" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#7c5310;fontSize=10;" value="Market Maker (بازارساز) • نقدینگی به بازار تزریق می‌کند • آماده خرید و فروش در هر زمان است • از اختلاف قیمت خرید/فروش (Spread) درآمد کسب می‌کند • ریسک موجودی (Inventory Risk) را می‌پذیرد • مدام قیمت خرید (Bid) و فروش (Ask) اعلام می‌کند" vertex="1">
          <mxGeometry height="170" width="270" x="917" y="21139" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-30" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#7c5310;fontSize=10;" value="Market Taker (بازارگیر) • نقدینگی را از بازار می‌گیرد • سفارشات موجود در Order Book را اجرا می‌کند • قیمت‌های اعلام‌شده بازارساز را می‌پذیرد • کارمزد بیشتری پرداخت می‌کند • به دنبال اجرای سریع معامله است" vertex="1">
          <mxGeometry height="170" width="270" x="1215" y="21139" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-31" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fafafa;strokeColor=#aaaaaa;fontColor=#555555;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="تاریخچه مفهوم بازارساز و بازارگیر  • 1602 — بورس آمستردام (VOC، شرکت هند شرقی هلند): اولین بورس رسمی جهان.   Jobbers (بازارساز) و Brokers/Dealers (بازارگیر) • قرن 18 — بورس لندن: Jobbers با موجودی شخصی معامله می‌کردند • 1792 — بورس نیویورک (NYSE): Specialists مسئول نگهداری بازار برای سهام خاص بودند" vertex="1">
          <mxGeometry height="180" width="560" x="917" y="21336" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-32" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#7c5310;fontSize=14;fontStyle=1;" value="Arbitrage — آربیتراژ" vertex="1">
          <mxGeometry height="44" width="440" x="1520" y="21081" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-33" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#7c5310;fontSize=11;" value="خرید و فروش همزمان یک دارایی در دو یا چند بازار مختلف برای کسب سود از اختلاف قیمت. آربیتراژ باعث همگرایی قیمت‌ها در بازارهای مختلف می‌شود." vertex="1">
          <mxGeometry height="80" width="440" x="1520" y="21151" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-34" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#7c5310;fontSize=11;" value="انواع آربیتراژ: • Pure (ساده) — همان دارایی در دو بازار • Triangular (مثلثی) — سه ارز در یک صرافی • Statistical (آماری) — بر پایه مدل‌های آماری • Geographical (جغرافیایی) — بین بازارهای جغرافیایی • Temporal (زمانی) — در زمان‌های مختلف • Merger (ادغام) — روی اعلام ادغام شرکت‌ها" vertex="1">
          <mxGeometry height="150" width="440" x="1520" y="21244" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-35" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#7c5310;fontSize=11;" value="تکنولوژی‌های مدرن: • Algorithmic Trading (معامله الگوریتمی) • High-Frequency Trading (HFT) — معامله فرکانس بالا • هوش مصنوعی و یادگیری ماشین" vertex="1">
          <mxGeometry height="110" width="440" x="1523.32" y="21406" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-36" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7a5d0a;fontSize=14;fontStyle=1;" value="(Decentralized Finance) DeFi — مالی غیرمتمرکز" vertex="1">
          <mxGeometry height="44" width="720" x="2000" y="21081" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-37" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7a5d0a;fontSize=11;" value="DeFi بدون بانک، بروکر یا واسطه کار می‌کند. روی بلاکچین (بیشتر اتریوم) با قراردادهای هوشمند خودکار اجرا می‌شود. اقتصاد باز و شفاف، بدون محدودیت جغرافیایی و زمانی، با دسترسی همگانی." vertex="1">
          <mxGeometry height="100" width="720" x="2000" y="21131" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-38" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7a5d0a;fontSize=11;" value="چرا DeFi مهم است؟ • کاهش قدرت نهادهای مالی متمرکز • دموکراسی مالی و دسترسی همگانی (Financial Inclusion) • جایگزین سیستم بانکی سنتی • ارائه خدمات مالی مشابه بانک‌ها بدون واسطه • شفافیت کامل — همه تراکنش‌ها روی بلاکچین قابل ممیزی‌اند" vertex="1">
          <mxGeometry height="130" width="720" x="2000" y="21241" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-39" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7a5d0a;fontSize=11;" value="ستون‌های فنی DeFi: ۱. بلاکچین (Ethereum، Solana، Polygon، Arbitrum...) ۲. قراردادهای هوشمند (Smart Contracts) ۳. اوراکل‌ها (Oracles) — پل به داده‌های دنیای واقعی ۴. کیف پول‌های غیرامانی (Non-custodial Wallets) ۵. استانداردها (ERC-20، ERC-721، ERC-4626، EIP-712)" vertex="1">
          <mxGeometry height="130" width="720" x="2000" y="21381" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-40" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#1f2937;strokeColor=#111827;fontColor=#ffffff;fontSize=16;fontStyle=1;" value="۳. اجزای اصلی DeFi — هفت ستون مالی غیرمتمرکز" vertex="1">
          <mxGeometry height="44" width="2400" x="320" y="21611" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-41" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fafafa;strokeColor=#aaaaaa;fontColor=#555555;fontSize=11;" value="این هفت جزء، بلوک‌های سازنده اکوسیستم DeFi هستند. هر کدام معادل یک بخش از سیستم مالی سنتی است، اما بدون نهاد مرکزی و روی بلاکچین اجرا می‌شود. ترکیب این اجزا با یکدیگر (Composability) به «Money Legos» معروف است." vertex="1">
          <mxGeometry height="70" width="2400" x="320" y="21671" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-42" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b4e7c8;strokeColor=#588878;fontColor=#1f4a3c;fontSize=14;fontStyle=1;" value="Lending &amp; Borrowing وام‌دهی و قرض‌گیری" vertex="1">
          <mxGeometry height="60" width="580" x="320" y="21761" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-43" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b4e7c8;strokeColor=#588878;fontColor=#1f4a3c;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="قرض دادن دارایی برای کسب سود، یا قرض گرفتن با ارائه وثیقه. بدون بانک، قرارداد هوشمند همه کار را می‌کند.  پلتفرم‌های معروف: Aave، Compound، MakerDAO، Spark" vertex="1">
          <mxGeometry height="160" width="580" x="320" y="21831" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-44" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b4e7c8;strokeColor=#588878;fontColor=#1f4a3c;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="وام‌دهنده: رمزارزی می‌سپارد و سود می‌گیرد وام‌گیرنده: وثیقه می‌گذارد و وام می‌گیرد" vertex="1">
          <mxGeometry height="80" width="580" x="320" y="22001" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-45" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b1ddf0;strokeColor=#4d9bcf;fontColor=#1e4d6b;fontSize=14;fontStyle=1;" value="DEX مبادلات غیرمتمرکز" vertex="1">
          <mxGeometry height="60" width="580" x="930" y="21761" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-46" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b1ddf0;strokeColor=#4d9bcf;fontColor=#1e4d6b;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="صرافی غیرمتمرکز برای تبدیل رمزارزها بدون واسطه. معامله فوری و بدون ثبت‌نام.  پلتفرم‌های معروف: Uniswap، Curve، Balancer، SushiSwap، 1inch" vertex="1">
          <mxGeometry height="160" width="580" x="930" y="21831" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-47" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#b1ddf0;strokeColor=#4d9bcf;fontColor=#1e4d6b;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="AMM: قیمت خودکار Order Book: سفارش خرید/فروش Aggregator: بهترین قیمت از چند DEX" vertex="1">
          <mxGeometry height="80" width="580" x="930" y="22001" as="geometry" />
        </mxCell>
        <mxCell id="Tl_rNCZSt6P0KQ3QG7Ih-48" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#742d2d;fontSize=14;fontStyle=1;" value="Stablecoin ارزهای پایدار" vertex="1">
          <mxGeometry height="60" width="580" x="1540" y="21761" as="geometry" />
