        <mxCell id="3u3cCtdTfGU9zsH9du92-303" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;&quot; data-end=&quot;746&quot; data-start=&quot;734&quot;&gt;پشتوانه:&lt;/span&gt; ۱:۱ دلار آمریکا&lt;br&gt;&lt;/font&gt;Gemini Exchange&amp;nbsp;&lt;font style=&quot;&quot;&gt;:صادرکننده&lt;br&gt;&lt;/font&gt;&lt;span style=&quot;&quot; data-end=&quot;550&quot; data-start=&quot;536&quot;&gt;&lt;span data-end=&quot;585&quot; data-start=&quot;566&quot;&gt;&lt;span data-end=&quot;550&quot; data-start=&quot;536&quot;&gt;KYC&amp;nbsp;&lt;/span&gt;قابلیت بازخرید:&lt;/span&gt;&amp;nbsp;بله، برای کاربران و موسسات با&lt;br&gt;&lt;/span&gt;&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font size=&quot;3&quot; style=&quot;&quot;&gt;&lt;b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot; data-end=&quot;1394&quot; data-start=&quot;1381&quot;&gt;ویژگی‌ها:&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; حسابرسی ماهانه، قابل اعتماد، کاملاً با دلار واقعی پشتیبانی شده&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;align=right;labelBackgroundColor=none;" vertex="1" parent="1">
